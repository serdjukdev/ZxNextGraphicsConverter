<Window x:Class="ZxNext.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:NewProjectViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Project" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16" Width="420">
        <TextBlock Text="Project name" FontSize="11" />
        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

        <TextBlock Text="Location" FontSize="11" />
        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseParentFolderCommand}" Margin="6,0,0,0" Padding="8,2" />
        </Grid>

        <TextBlock Text="Project will be created at:" FontSize="11" Foreground="Gray" Margin="0,8,0,0" />
        <TextBlock Text="{Binding FullPath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />

        <TextBlock Text="{Binding ValidationMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Create" Width="90" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Create_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
