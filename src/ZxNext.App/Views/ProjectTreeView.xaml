<UserControl x:Class="ZxNext.App.Views.ProjectTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
             xmlns:local="clr-namespace:ZxNext.App"
             d:DataContext="{d:DesignInstance Type=vm:ProjectTreeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Padlock icon for asset rows: a filled body plus a stroked shackle whose shape (closed vs
             open) is swapped by a DataTrigger on TreeNodeViewModel.IsLocked. Drawn in a 16x16 box,
             shown scaled down via a Viewbox in the row template. -->
        <Geometry x:Key="LockBodyGeometry">M4.5,7 L11.5,7 A1.5,1.5 0 0 1 13,8.5 L13,13.5 A1.5,1.5 0 0 1 11.5,15 L4.5,15 A1.5,1.5 0 0 1 3,13.5 L3,8.5 A1.5,1.5 0 0 1 4.5,7 Z</Geometry>
        <Geometry x:Key="LockShackleClosedGeometry">M5,7 L5,5 A3,3 0 0 1 11,5 L11,7</Geometry>
        <Geometry x:Key="LockShackleOpenGeometry">M5,7 L5,5 A3,3 0 0 1 10.8,3.6</Geometry>

        <Style x:Key="LockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LockBodyStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource LockBodyGeometry}" />
            <Setter Property="Fill" Value="#C0BFBFBF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Fill" Value="#FFE0A000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LockShackleStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource LockShackleOpenGeometry}" />
            <Setter Property="Stroke" Value="#C0999999" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Data" Value="{StaticResource LockShackleClosedGeometry}" />
                    <Setter Property="Stroke" Value="#FFB07A00" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Layer2 "priority" (draw-on-top) toggle for Tile8Bpp rows: an up-arrow, grey when off,
             green with a white outline when on, mirroring TreeNodeViewModel.IsPriority. -->
        <Geometry x:Key="PriorityArrowGeometry">M8,3 L14.5,13 L1.5,13 Z</Geometry>
        <Style x:Key="PriorityArrowStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource PriorityArrowGeometry}" />
            <Setter Property="Fill" Value="#C0999999" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriority}" Value="True">
                    <Setter Property="Fill" Value="#FF2FA02F" />
                    <Setter Property="Stroke" Value="White" />
                    <Setter Property="StrokeThickness" Value="1.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Show in Map Editor" checkbox for Sprite4Bpp/Sprite8Bpp sub-folder rows: an empty grey-outlined
             box when OFF, a filled blue box with a white tick when ON (TreeNodeViewModel.IsMapRepresentative).
             Independent per row, unlike the lock/priority icons this has no "only one" rule at all. -->
        <Geometry x:Key="MapRepresentativeBoxGeometry">M4.5,3 L11.5,3 A1.5,1.5 0 0 1 13,4.5 L13,11.5 A1.5,1.5 0 0 1 11.5,13 L4.5,13 A1.5,1.5 0 0 1 3,11.5 L3,4.5 A1.5,1.5 0 0 1 4.5,3 Z</Geometry>
        <Geometry x:Key="MapRepresentativeCheckGeometry">M4.5,8.3 L7,10.8 L11.5,4.8</Geometry>
        <Style x:Key="MapRepresentativeBoxStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource MapRepresentativeBoxGeometry}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="#C0999999" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMapRepresentative}" Value="True">
                    <Setter Property="Fill" Value="#FF3388FF" />
                    <Setter Property="Stroke" Value="#FF1A5FBF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MapRepresentativeCheckStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource MapRepresentativeCheckGeometry}" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMapRepresentative}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,2">
            <Button Content="Expand all" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                    Command="{Binding ExpandAllCommand}" />
            <Button Content="Collapse all" FontSize="10" Padding="6,2"
                    Command="{Binding CollapseAllCommand}" />
        </StackPanel>
        <TreeView x:Name="Tree" ItemsSource="{Binding Roots}"
              SelectedItemChanged="Tree_OnSelectedItemChanged"
              PreviewMouseLeftButtonDown="Tree_OnPreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="Tree_OnPreviewMouseLeftButtonUp"
              PreviewMouseMove="Tree_OnPreviewMouseMove"
              PreviewMouseRightButtonDown="Tree_OnPreviewMouseRightButtonDown"
              AllowDrop="True" DragOver="Tree_OnDragOver" Drop="Tree_OnDrop" DragLeave="Tree_OnDragLeave"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              BorderThickness="0">
        <TreeView.InputBindings>
            <KeyBinding Key="{x:Static local:Shortcuts.DeleteKey}" Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <KeyBinding Key="{x:Static local:Shortcuts.ReQuantizeKey}" Modifiers="{x:Static local:Shortcuts.ReQuantizeModifiers}" Command="{Binding DataContext.RequestReQuantizeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </TreeView.InputBindings>
        <TreeView.ItemContainerStyle>
            <!-- Full custom template: the built-in TreeViewItem template's header column is only
                 Auto-sized (fits the content, not the row), so clicks past the name/icons fell
                 through to nothing. Here the header Border sits in an explicit "*" column, so it
                 always spans the row's full available width and is clickable/double-clickable
                 everywhere, not just on the text itself.

                 Folder rows (category roots + user sub-folders) are drawn as a rounded "chip": a
                 tinted fill (RowFill) plus a 3px left accent bar (RowAccent), tint by category type
                 (4bpp green / 8bpp blue / Layer2 violet; a sub-folder is a lighter shade of its
                 parent). Leaf rows are flat with a faint zebra stripe (IsOddRow). -->
            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="3,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="RowBorder" Background="{Binding RowFill}"
                                        BorderBrush="{Binding RowAccent}" BorderThickness="0"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="AccentBar" Grid.Column="0"
                                                   Fill="{Binding RowAccent}" Visibility="Collapsed" />
                                        <ToggleButton x:Name="Expander" Grid.Column="1"
                                                      Focusable="False" ClickMode="Press"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Width="16" Height="16" Background="Transparent">
                                                        <Path x:Name="Arrow" Data="M 2 2 L 8 6 L 2 10 Z"
                                                              Fill="#FF666666" Stretch="Uniform" Width="7" Height="8"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <Border Grid.Column="2" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="PART_Header"
                                                              ContentSource="Header" HorizontalAlignment="Stretch" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <!-- Folder chip chrome. -->
                                <DataTrigger Binding="{Binding IsChipRow}" Value="True">
                                    <Setter TargetName="RowBorder" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="RowBorder" Property="Margin" Value="2,1" />
                                    <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- Leaf zebra (set before selection so a selected odd row still highlights). -->
                                <DataTrigger Binding="{Binding IsOddRow}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#0A000000" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{Binding SelectionFill}" />
                                    <Setter TargetName="RowBorder" Property="CornerRadius" Value="3" />
                                    <Setter TargetName="RowBorder" Property="Margin" Value="2,1" />
                                </DataTrigger>
                                <!-- "Drop here to move the dragged asset into this folder" highlight. -->
                                <DataTrigger Binding="{Binding IsMoveDropTarget}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#FFD3E0F2" />
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF5B84C0" />
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="RowBorder" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="RowBorder" Property="Margin" Value="2,1" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <!-- ContextMenu (and its Opening handler) sits on the row's ROOT StackPanel, not just the
                     TextBlock — a ContextMenu only opens when you right-click the exact element it's
                     assigned to (or one of ITS descendants), so attaching it to the text alone meant
                     right-clicking anywhere else in the row (the same full-width area the left-click
                     fix already made clickable) silently did nothing. -->
                <Grid Background="Transparent">
                    <!-- ContextMenu (and its Opening handler) sits on a full-row-width element, not just the
                         text — a ContextMenu only opens when you right-click the exact element it's assigned
                         to (or one of ITS descendants), so attaching it to the text alone meant right-clicking
                         anywhere else in the row silently did nothing. -->
                    <Grid Background="Transparent" ContextMenuOpening="NodeText_OnContextMenuOpening">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Fixed right cluster so the lock (and, on Tile8Bpp, the priority arrow, and on
                                 a Sprite4Bpp/Sprite8Bpp sub-folder leaf, the map-icon checkbox) sit at the
                                 same X on every row and line up vertically down the list. 54 fit the original
                                 2 icons (priority slot + lock); widened to fit 3. -->
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <!-- One shared, always-present ContextMenu for every node type (leaf or folder) —
                             NodeText_OnContextMenuOpening toggles Items[i].Visibility/Header by index
                             depending on the node and the current multi-selection. Item order:
                             0 Rename, 1 Re-quantize, 2 Delete, 3 Lock/Unlock, 4 Add sub-folder,
                             5 Re-quantize folder, 6 Delete folder, 7 Delete unused,
                             8 Lock all in folder, 9 Unlock all in folder, 10 Priority (Tile8Bpp only),
                             11 Show/Hide in Map Editor (Sprite4Bpp/Sprite8Bpp sub-folder leaf only),
                             12 Animation target (Tile4Bpp sub-folder FOLDER only). -->
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename..." Click="RenameMenuItem_OnClick" />
                                <MenuItem Header="Re-quantize... (Ctrl+R)" Click="ReQuantizeMenuItem_OnClick" />
                                <MenuItem Header="Delete" Click="DeleteMenuItem_OnClick" />
                                <MenuItem Header="Lock" Click="LockMenuItem_OnClick"
                                          ToolTip="Protect this tile/sprite from ever being deleted (including 'Delete unused')" />
                                <MenuItem Header="Add sub-folder..." Click="AddSubfolderMenuItem_OnClick"
                                          ToolTip="Add a sub-folder here (its own 8bpp/Layer2 palette)" />
                                <MenuItem Header="Re-quantize folder..." Click="ReQuantizeFolderMenuItem_OnClick"
                                          ToolTip="Re-quantize every tile/sprite in THIS folder only, with a chosen dithering mode" />
                                <MenuItem Header="Delete folder..." Click="DeleteFolderMenuItem_OnClick" />
                                <MenuItem Header="Delete unused..." Click="DeleteUnusedMenuItem_OnClick"
                                          ToolTip="Delete every tile/sprite here that no map places and that isn't locked" />
                                <MenuItem Header="Lock all in folder" Click="LockAllFolderMenuItem_OnClick"
                                          ToolTip="Lock every tile/sprite in this folder to protect it from deletion" />
                                <MenuItem Header="Unlock all in folder" Click="UnlockAllFolderMenuItem_OnClick"
                                          ToolTip="Remove the delete-lock from every tile/sprite in this folder" />
                                <MenuItem Header="Priority" Click="PriorityMenuItem_OnClick"
                                          ToolTip="Layer2 priority: a priority tile draws on top of every layer on real hardware" />
                                <MenuItem Header="Show in Map Editor" Click="MapRepresentativeMenuItem_OnClick" />
                                <MenuItem Header="Animation target..." Click="AnimationTargetMenuItem_OnClick"
                                          ToolTip="Tile4Bpp sub-folder only: say which metatile's tiles this folder's frames overwrite at runtime" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Image Source="{Binding Thumbnail}" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                            <TextBlock Text="{Binding IndexLabel}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FF808080" />
                            <!-- Sub-folder / asset names are truncated with an ellipsis (full name on hover);
                                 the fixed-set category roots show their friendly label in full. -->
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="MaxWidth" Value="120" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCategoryRoot}" Value="True">
                                                <Setter Property="MaxWidth" Value="1000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- "Show in Map Editor" checkbox — shown only on a Sprite4Bpp/Sprite8Bpp sub-folder
                                 leaf (TreeNodeViewModel.CanBeMapRepresentative); click toggles just this one
                                 sprite's own visibility in the Map Editor's sprite palette. Placed right next
                                 to the padlock, per the user's own request. -->
                            <Button Click="MapRepresentativeButton_OnClick" Margin="0,0,2,0"
                                    ToolTip="Show this sprite as its own entry in the Map Editor's sprite palette, independently of other frames in this sub-folder. Purely a palette preview, never changes already-placed objects.">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LockButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanBeMapRepresentative}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Path Style="{StaticResource MapRepresentativeBoxStyle}" />
                                        <Path Style="{StaticResource MapRepresentativeCheckStyle}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Layer2 priority (draw-on-top) toggle — shown only on Tile8Bpp rows, but the slot
                                 is kept (Hidden, not Collapsed) elsewhere so the lock never shifts. -->
                            <Button Click="PriorityButton_OnClick" Margin="0,0,2,0"
                                    ToolTip="Toggle Layer2 priority: a priority tile is drawn on top of every layer on real hardware">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LockButtonStyle}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTile8Bpp}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReservedBlank}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Path Style="{StaticResource PriorityArrowStyle}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Padlock on every asset row (open = deletable, closed amber = locked); click
                                 toggles just this asset, the right-click menu also does bulk. Hidden on folder
                                 rows and the reserved blank (permanently undeletable anyway). -->
                            <Button Click="LockButton_OnClick"
                                    ToolTip="Lock / unlock this tile/sprite (a locked one can never be deleted)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LockButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReservedBlank}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Path Style="{StaticResource LockBodyStyle}" />
                                        <Path Style="{StaticResource LockShackleStyle}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Drag-and-drop reorder feedback (ProjectTreeView.xaml.cs) — a thin line showing exactly where a dragged tile/sprite row will land. -->
                    <Border Height="2" VerticalAlignment="Top" Background="#FF3388FF" IsHitTestVisible="False"
                            Visibility="{Binding ShowDropIndicatorAbove, Converter={StaticResource BoolToVis}}" />
                    <Border Height="2" VerticalAlignment="Bottom" Background="#FF3388FF" IsHitTestVisible="False"
                            Visibility="{Binding ShowDropIndicatorBelow, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
