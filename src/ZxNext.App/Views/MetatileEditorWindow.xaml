<Window x:Class="ZxNext.App.Views.MetatileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MetatileEditorViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Metatile Editor" Height="700" Width="1000" MinWidth="750" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ThumbnailListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4FF" />
                    <Setter Property="BorderBrush" Value="#2A7FFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A7A1A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootSplitGrid" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColumn" Width="300" MinWidth="240" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- Left: Kind selector, then split into (1) tile palette to paint with, (2) existing metatile library -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Kind" FontSize="11" Margin="0,0,0,2" />
            <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableKinds}" DisplayMemberPath="Label"
                      SelectedValuePath="Kind" SelectedValue="{Binding SelectedKind}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="2" Text="Tile palette — click a tile, then click a cell on the right to paint it" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" />
            <Border Grid.Row="3" BorderBrush="#999" BorderThickness="1">
                <ListBox ItemsSource="{Binding TilePalette}" SelectedItem="{Binding SelectedPaletteTile}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Background="Transparent" ToolTip="{Binding Name}">
                                <Image Source="{Binding Preview}" Width="48" Height="48" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="52" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <TextBlock Grid.Row="4" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"
                       Text="{Binding SelectedPaletteTile.Name, StringFormat='Painting with: {0}', TargetNullValue='Painting with: (click a tile above)'}" />

            <TextBlock Grid.Row="6" Text="Existing metatiles" FontSize="11" Margin="0,0,0,2" />
            <Border Grid.Row="7" BorderBrush="#999" BorderThickness="1">
                <ListBox ItemsSource="{Binding Metatiles}" SelectedItem="{Binding SelectedMetatile}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Background="Transparent" ToolTip="{Binding Name}">
                                <Image Source="{Binding Preview}" Width="56" Height="56" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="60" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SizeLabel}" FontSize="8" Foreground="Gray" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Button Grid.Row="8" Content="Delete selected" Command="{Binding DeleteMetatileCommand}"
                    HorizontalAlignment="Left" Width="120" Margin="0,6,0,0" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCC"
                      DragDelta="MainSplitter_OnDragDelta" />

        <!-- Right: build a new metatile -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="New metatile" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditingExisting}" Value="True">
                                <Setter Property="Text" Value="{Binding SelectedMetatile.Metatile.Name, StringFormat='Editing \'{0}\''}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" MinHeight="16" Margin="0,8,0,0" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Command="{Binding NewMetatileCommand}" Visibility="{Binding IsEditingExisting, Converter={StaticResource BoolToVis}}"
                        ToolTip="Discard these changes and clear the draft — nothing is saved" Width="70" Margin="0,0,6,0" />
                <Button Content="{Binding CreateOrSaveButtonText}" IsEnabled="{Binding IsDraftValid}"
                        Command="{Binding CreateMetatileCommand}" Width="140" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="Result preview:" FontSize="11" Margin="0,8,0,2" />
            <Border DockPanel.Dock="Bottom" BorderBrush="#999" BorderThickness="1" Width="220" Height="220" HorizontalAlignment="Left" Margin="0,0,0,0">
                <Image Source="{Binding DraftPreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Select a tile in the palette on the left, then click any cell below to paint it." />
                        <Setter Property="Foreground" Value="Gray" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaintModeActive}" Value="True">
                                <Setter Property="Text" Value="Tile selected — click any highlighted cell below to paint it there." />
                                <Setter Property="Foreground" Value="#1A7A1A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding DraftCells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.DraftGridSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#999" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsPaintModeActive, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#2ECC40" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Button Width="72" Height="72" Padding="0" BorderThickness="0" Background="#EEE"
                                            Command="{Binding DataContext.AssignSelectedTileToCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Click to paint this cell with the tile selected in the palette on the left">
                                        <Grid>
                                            <TextBlock Text="+" FontSize="32" Foreground="#BBB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                                            <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Grid>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsFourBpp, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Mirror X" IsChecked="{Binding MirrorX}" Margin="0,0,8,0" />
                                        <CheckBox Content="Mirror Y" IsChecked="{Binding MirrorY}" Margin="0,0,8,0" />
                                        <CheckBox Content="Rotate" IsChecked="{Binding Rotate}"
                                                  ToolTip="Transposes the tile (diagonal flip). Combined with Mirror X/Y this reaches all 8 possible orientations — the ZX Next tilemap hardware has no separate 90/180/270 degree rotation, only this one transpose bit plus the two mirror bits." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding CanOverridePalette, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding NativePaletteSlotLabel}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <ComboBox ItemsSource="{Binding AvailablePaletteSlots}" SelectedItem="{Binding EffectivePaletteSlot}" Width="46" FontSize="9"
                                                  ToolTip="Recolor: read this cell's tile against a DIFFERENT palette slot than its own native one." />
                                        <Button Content="&#8630;" Width="20" Margin="4,0,0,0" Command="{Binding ResetPaletteToNativeCommand}"
                                                Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Reset to the tile's own native palette slot" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
