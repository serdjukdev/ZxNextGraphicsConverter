<Window x:Class="ZxNext.App.Views.ObjectDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Object Data" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="14" Width="360">
        <TextBlock x:Name="HeaderText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Palette 0-15" FontSize="11" />
                <TextBox x:Name="PaletteBox" />
                <CheckBox x:Name="PaletteFromType" Content="from type" FontSize="10" Margin="0,3,0,0"
                          Checked="FromType_OnChanged" Unchecked="FromType_OnChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                <TextBlock Text="Width px" FontSize="11" />
                <TextBox x:Name="WidthBox" />
                <CheckBox x:Name="WidthFromType" Content="from type" FontSize="10" Margin="0,3,0,0"
                          Checked="FromType_OnChanged" Unchecked="FromType_OnChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height px" FontSize="11" />
                <TextBox x:Name="HeightBox" />
                <CheckBox x:Name="HeightFromType" Content="from type" FontSize="10" Margin="0,3,0,0"
                          Checked="FromType_OnChanged" Unchecked="FromType_OnChanged" />
            </StackPanel>
        </Grid>

        <TextBlock Text="A field with 'from type' ticked follows its object type, so changing the type later changes this object too. Untick it to pin a value on this object alone. These reach the binary only while 'Extended object bytes' is on in Settings." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="OK" Width="80" IsDefault="True" Click="Confirm_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
