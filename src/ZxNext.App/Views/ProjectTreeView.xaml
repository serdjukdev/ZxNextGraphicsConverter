<UserControl x:Class="ZxNext.App.Views.ProjectTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProjectTreeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,2">
            <Button Content="Expand all" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                    Command="{Binding ExpandAllCommand}" />
            <Button Content="Collapse all" FontSize="10" Padding="6,2"
                    Command="{Binding CollapseAllCommand}" />
        </StackPanel>
        <TreeView x:Name="Tree" ItemsSource="{Binding Roots}"
              SelectedItemChanged="Tree_OnSelectedItemChanged"
              PreviewMouseLeftButtonDown="Tree_OnPreviewMouseLeftButtonDown"
              PreviewMouseRightButtonDown="Tree_OnPreviewMouseRightButtonDown"
              AllowDrop="True" DragOver="Tree_OnDragOver" Drop="Tree_OnDrop"
              BorderThickness="0">
        <TreeView.InputBindings>
            <KeyBinding Key="Delete" Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <KeyBinding Key="R" Modifiers="Control" Command="{Binding DataContext.RequestReQuantizeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </TreeView.InputBindings>
        <TreeView.ItemContainerStyle>
            <!-- Full custom template: the built-in TreeViewItem template's header column is only
                 Auto-sized (fits the content, not the row), so clicks past the name/icons fell
                 through to nothing. Here the header Border sits in an explicit "*" column, so it
                 always spans the row's full available width and is clickable/double-clickable
                 everywhere, not just on the text itself. -->
            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="2,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                                      Focusable="False" ClickMode="Press"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Width="16" Height="16" Background="Transparent">
                                                        <Path x:Name="Arrow" Data="M 2 2 L 8 6 L 2 10 Z"
                                                              Fill="#FF666666" Stretch="Uniform" Width="7" Height="8"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                          ContentSource="Header" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                                <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="White" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    <Setter TargetName="PART_Header" Property="TextElement.Foreground" Value="White" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter Property="Background" Value="#FFE7EEF9" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFolder}" Value="False">
                        <Setter Property="Background" Value="#FFF6F6F6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               ContextMenuOpening="NodeText_OnContextMenuOpening">
                        <!-- One shared, always-present ContextMenu for every node type (leaf or folder) —
                             NodeText_OnContextMenuOpening toggles Items[i].Visibility/Header by index
                             depending on the node and the current multi-selection. Item order:
                             0 Rename, 1 Re-quantize, 2 Delete, 3 Add sub-folder, 4 Re-quantize folder, 5 Delete folder. -->
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename..." Click="RenameMenuItem_OnClick" />
                                <MenuItem Header="Re-quantize... (Ctrl+R)" Click="ReQuantizeMenuItem_OnClick" />
                                <MenuItem Header="Delete" Click="DeleteMenuItem_OnClick" />
                                <MenuItem Header="Add sub-folder..." Click="AddSubfolderMenuItem_OnClick"
                                          ToolTip="Add a sub-folder here (its own 8bpp/Layer2 palette)" />
                                <MenuItem Header="Re-quantize folder..." Click="ReQuantizeFolderMenuItem_OnClick"
                                          ToolTip="Re-quantize every tile/sprite in THIS folder only, with a chosen dithering mode" />
                                <MenuItem Header="Delete folder..." Click="DeleteFolderMenuItem_OnClick" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </StackPanel>
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
