<Window x:Class="ZxNext.App.Views.NewSubfolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="New Sub-folder" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="14" Width="280">
        <TextBlock Text="Sub-folder name (its own 8bpp palette):" FontSize="11" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Create" Width="80" IsDefault="True" Click="Create_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
