<Window x:Class="ZxNext.App.Views.NextColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:NextColorPickerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pick Next Colour" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock Text="Pick one of the 512 ZX Next hardware colours — grouped into 8 blocks by R value (columns = G, rows = B)."
                   TextWrapping="Wrap" MaxWidth="460" Margin="0,0,0,10" />

        <ItemsControl ItemsSource="{Binding Blocks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="2" Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NextColorBlockViewModel}">
                    <Border BorderBrush="#999" BorderThickness="1" Margin="3" Padding="3">
                        <StackPanel>
                            <TextBlock Text="{Binding R, StringFormat='R = {0}'}" FontSize="9"
                                       HorizontalAlignment="Center" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NextColorSwatchViewModel}">
                                        <Border Width="14" Height="14" Background="{Binding Brush}"
                                                ToolTip="{Binding Tooltip}"
                                                MouseLeftButtonDown="Swatch_OnMouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#AAA" />
                                                    <Setter Property="BorderThickness" Value="0.3" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#FF2AA1FF" />
                                                            <Setter Property="BorderThickness" Value="2.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="24" BorderBrush="#666" BorderThickness="1"
                    Background="{Binding SelectedBrush}" />
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding SelectedLabel}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="OK" Width="80" IsDefault="True" IsEnabled="{Binding HasSelection}" Click="Ok_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
