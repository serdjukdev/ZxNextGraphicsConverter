<Window x:Class="ZxNext.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="560" Width="520" WindowStartupLocation="CenterOwner"
        Loaded="SettingsWindow_OnLoaded">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,16">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_OnClick" />
        </StackPanel>

        <TabControl Margin="16,16,16,0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,10">
                    <StackPanel>
                        <TextBlock Text="Export filename postfixes" FontWeight="Bold" FontSize="12" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Graphics data (_gfx)" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GraphicsDataSuffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tilemap grid (_grid)" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TilemapGridSuffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tilemap metatiles (_metatiles)" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TilemapMetatilesSuffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="8bpp grid (_grid)" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EightBppGridSuffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="8bpp metatiles (_metatiles)" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EightBppMetatilesSuffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Objects (_objects)" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ObjectsSuffix, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />
                        </Grid>

                        <TextBlock Text="Default dither mode for new imports" FontWeight="Bold" FontSize="12" Margin="0,16,0,0" />
                        <ComboBox ItemsSource="{Binding AvailableDitherModes}" SelectedItem="{Binding DefaultDitherMode}" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0" />

                        <TextBlock Text="Default export chunk size for a new row" FontWeight="Bold" FontSize="12" Margin="0,16,0,0" />
                        <ComboBox ItemsSource="{Binding AvailableChunkSizes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding DefaultExportChunkSize}" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0" />

                        <TextBlock Text="Default New Map size" FontWeight="Bold" FontSize="12" Margin="0,16,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                            <TextBox Grid.Column="1" Text="{Binding DefaultMapWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="2" Text="Height:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                            <TextBox Grid.Column="3" Text="{Binding DefaultMapHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <TextBlock Text="Default New Project metatile size" FontWeight="Bold" FontSize="12" Margin="0,16,0,0" />
                        <TextBlock Text="Only affects the initial selection in the New Project dialog — still changeable there per project." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton x:Name="GridSize1" Content="1x1" GroupName="SettingsDefaultGridSize" Margin="0,0,14,0" />
                            <RadioButton x:Name="GridSize2" Content="2x2" GroupName="SettingsDefaultGridSize" Margin="0,0,14,0" />
                            <RadioButton x:Name="GridSize4" Content="4x4" GroupName="SettingsDefaultGridSize" />
                        </StackPanel>

                        <TextBlock Text="Map Editor grid overlay" FontWeight="Bold" FontSize="12" Margin="0,16,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tile grid colour:" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MapEditorTileGridColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,10,2" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Opacity:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding MapEditorTileGridOpacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cell grid colour:" VerticalAlignment="Center" FontSize="11" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MapEditorCellGridColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,10,2" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Opacity:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MapEditorCellGridOpacity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2" />
                        </Grid>
                        <TextBlock Text="Colours as hex (e.g. #FFFFFF). The tile grid is the faint 8x8 grid, the cell grid is the brighter metatile-size grid." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,10">
                    <ItemsControl ItemsSource="{Binding ShortcutGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Area}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,2,0,2" ToolTip="{Binding FullDescription}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Gesture}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ShortDescription}" FontSize="11" Foreground="#444" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
