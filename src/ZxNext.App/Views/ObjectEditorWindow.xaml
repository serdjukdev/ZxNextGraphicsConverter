<Window x:Class="ZxNext.App.Views.ObjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ObjectEditorViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Object Editor" Width="1000" Height="800" MinWidth="860" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="EditorStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A7A1A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" FontSize="10" Foreground="Gray" TextWrapping="Wrap"
                   Text="An object is a named group of sprites: a 5-wide platform, a character of one sprite over two. Each ROW has its own length and its own offset, so the shape does not have to be a rectangle. An object holds named ANIMATIONS, each a list of frames, and a frame is one such layout plus how long it is held; a still object is simply a one-frame animation. The Map Editor places an object as a single unit and draws its first frame. Each animation exports a complete table into object_anims.asm: its sprites, their signed offsets from the first one and each sprite's own palette, and nothing else. The Hitbox button draws the object's collision box over its art: that box is what the game knows the object by, so a map placement's X/Y is the box's corner and the record carries drawX/drawY back to the picture." />

        <!-- left: two tabs, the object library and the project's object types -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <ToggleButton Content="Objects" MinWidth="76" Padding="8,2" IsChecked="{Binding IsObjectsTabActive, Mode=OneWay}"
                              Command="{Binding ShowObjectsTabCommand}" ToolTip="The objects you build out of sprites." />
                <ToggleButton Content="Types" MinWidth="76" Padding="8,2" Margin="4,0,0,0" IsChecked="{Binding IsTypesTabActive, Mode=OneWay}"
                              Command="{Binding ShowTypesTabCommand}"
                              ToolTip="Object types and their subtypes: project-wide exported data (the object record's type byte, the obj_ numbers, each map's per-type counts and the init order)." />
            </StackPanel>

            <!-- Types tab -->
            <DockPanel DockPanel.Dock="Top" Visibility="{Binding IsTypesTabActive, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Bottom" IsEnabled="{Binding HasManagedTypeSelection}">
                    <TextBlock Text="{Binding ManagedTypeHeader}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Size for a placement that has this type but no object of its own:" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="W px" FontSize="10" />
                            <TextBox Text="{Binding ManagedTypeWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="H px" FontSize="10" />
                            <TextBox Text="{Binding ManagedTypeHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Subtypes (max 8, one bit of the user byte each)" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,2" />
                    <Border BorderBrush="#999" BorderThickness="1">
                        <ListBox x:Name="SubtypeList" Height="96" BorderThickness="0"
                                 ItemsSource="{Binding SubtypeRows}" SelectedItem="{Binding SelectedSubtypeRow}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,3" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename..." Click="RenameSubtypeMenuItem_OnClick" />
                                                <MenuItem Header="Delete" Click="DeleteSubtypeMenuItem_OnClick" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <TextBlock Text="{Binding Display}" ToolTip="Right-click for Rename and Delete." />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Add..." Width="70" Height="24" Click="AddSubtype_OnClick"
                                ToolTip="Adds a subtype on the lowest free bit. Rename and Delete are on its right-click menu." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="bit" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="52" Height="24" ItemsSource="{Binding BitChoices}" SelectedItem="{Binding SelectedSubtypeBit}"
                                      ToolTip="Which bit of the user byte the selected subtype owns. A bit another subtype of this type already owns is refused." />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Add..." Height="26" Margin="0,6,0,0" Click="AddType_OnClick"
                        ToolTip="Create an object type: asks for a name. Rename and Delete are on the type's own right-click menu." />
                <Border BorderBrush="#999" BorderThickness="1" Height="150">
                    <ListBox x:Name="TypeList" ItemsSource="{Binding TypeRows}" SelectedItem="{Binding SelectedManagedType}"
                             BorderThickness="0"
                             PreviewMouseLeftButtonDown="TypeList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="TypeList_OnPreviewMouseMove"
                             AllowDrop="True" Drop="TypeList_OnDrop"
                             DragOver="TypeList_OnDragOver" DragLeave="TypeList_OnDragLeave">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="BorderBrush" Value="#2ECC40" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename..." Click="RenameTypeMenuItem_OnClick" />
                                            <MenuItem Header="Delete" Click="DeleteTypeMenuItem_OnClick" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Text="{Binding Display}" ToolTip="The number on the left is this type's exported obj_ number, which is its position in the list. Drag to reorder. Right-click for Rename and Delete." />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Objects tab -->
            <TextBlock DockPanel.Dock="Top" Text="Objects" FontSize="11" Margin="0,0,0,4"
                       Visibility="{Binding IsObjectsTabActive, Converter={StaticResource BoolToVis}}" />
            <Button DockPanel.Dock="Bottom" Content="Add..." Height="26" Margin="0,6,0,0" Click="Add_OnClick"
                    Visibility="{Binding IsObjectsTabActive, Converter={StaticResource BoolToVis}}"
                    ToolTip="Create a new object: asks for a name. Rename and Delete live on the object's own right-click menu." />
            <Border BorderBrush="#999" BorderThickness="1" Visibility="{Binding IsObjectsTabActive, Converter={StaticResource BoolToVis}}">
                <ListBox x:Name="DefinitionList" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}"
                         BorderThickness="0"
                         PreviewMouseLeftButtonDown="DefinitionList_OnPreviewMouseLeftButtonDown"
                         PreviewMouseMove="DefinitionList_OnPreviewMouseMove"
                         AllowDrop="True" Drop="DefinitionList_OnDrop"
                         DragOver="DefinitionList_OnDragOver" DragLeave="DefinitionList_OnDragLeave">
                    <ListBox.ItemContainerStyle>
                        <!-- Without this the row's content is only as wide as its text, so a right-click
                             next to a short name lands on the ListBox instead of the item and its menu
                             never opens. -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3" />
                            <!-- The drop indicator during a reorder drag is this border, switched on for one
                                 row at a time by the code-behind (see DefinitionList_OnDragOver). -->
                            <Setter Property="BorderBrush" Value="#2ECC40" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The menu sits on a full-width element so a right-click anywhere on the row opens it. -->
                            <Grid Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename..." Click="RenameMenuItem_OnClick" />
                                        <MenuItem Header="Delete" Click="DeleteMenuItem_OnClick" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Text="{Binding Name}" ToolTip="Drag to reorder. Right-click for Rename and Delete." />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- right: the selected object -->
        <DockPanel Grid.Row="1" Grid.Column="1" IsEnabled="{Binding HasSelection}"
                   Visibility="{Binding IsObjectsTabActive, Converter={StaticResource BoolToVis}}">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Type:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="130" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name"
                              ToolTip="The type every NEW placement of this object starts with. Objects already on a map keep the type they were placed with, since a placement owns its own copy. The empty row means no type." />
                    <TextBlock Text="Exported size px:" FontSize="11" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="44" Text="{Binding SizePixelsWidth, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                             IsEnabled="{Binding ManualSize}" />
                    <TextBlock Text="x" FontSize="11" VerticalAlignment="Center" Margin="5,0,5,0" />
                    <TextBox Width="44" Text="{Binding SizePixelsHeight, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                             IsEnabled="{Binding ManualSize}" />
                    <CheckBox Content="from the picture" IsChecked="{Binding AutoSize}" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Ticked: the exported width/height is what the sprites measure. Unticked: the two numbers are used instead, which is what a hitbox usually needs (a 32x32 picture of a one-sprite-wide character wants 16x32)." />
                    <Button Content="Hitbox..." Height="24" Padding="12,0" Margin="14,0,0,0" Click="Hitbox_OnClick"
                            ToolTip="Draw this object's collision box over its own art: drag the box, drag a handle on any side or corner, or type the numbers. The box IS the exported width/height, plus where the picture sits relative to it." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Subtype:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="110" ItemsSource="{Binding Subtypes}" SelectedItem="{Binding SelectedSubtype}" DisplayMemberPath="Name"
                              ToolTip="Sets that subtype's bit in the user byte and clears the other subtypes' bits. Every other bit stays as it is. The empty row means no subtype." />
                    <TextBlock Text="User byte:" FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox Width="44" Text="{Binding UserByteNumber, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                             ToolTip="0-255, the value a NEW placement of this object starts with. The bit buttons to the right and the subtype above edit this same byte." />
                    <ItemsControl ItemsSource="{Binding UserByteBits}" Margin="8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- MSB on the left, like the dialog on the map -->
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel FlowDirection="LeftToRight" Margin="1,0">
                                    <ToggleButton Width="32" Content="{Binding Label}" IsChecked="{Binding IsSet}" ToolTip="{Binding ToolTipText}" />
                                    <TextBlock Text="{Binding SubtypeName}" FontSize="8" Foreground="Gray" TextTrimming="CharacterEllipsis"
                                               MaxWidth="32" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding UserByteText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="The type and user byte above are what a NEW placement of this object starts with. Objects already on a map keep their own copy, so that 'Set User Byte' on one of them is not undone from here; change one on the map with its right-click menu."
                           FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PaletteText}" FontSize="10" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MixedPaletteWarning}" FontSize="10" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>


            <!-- animations and their frames. A frame IS the row layout below, so the row editor always
                 edits the selected frame; a still object is simply a one-frame animation. -->
            <Border DockPanel.Dock="Top" Margin="0,8,0,0" Padding="6,4" BorderBrush="#BBB" BorderThickness="1" Background="#F4F4F4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Animations" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Content="Add..." Width="64" Height="24" Click="AddAnimation_OnClick"
                                ToolTip="Another animation of this object: asks for a name. Rename and Delete are on the animation's own right-click menu. Each animation exports its own complete table." />
                    </StackPanel>

                    <!-- The strip scrolls sideways when it overflows: the buttons and thumbnails keep their size. -->
                    <ListBox x:Name="AnimationList" Grid.Row="0" Grid.Column="1" Height="30"
                             BorderBrush="#999" BorderThickness="1"
                             ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="AnimationList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="AnimationList_OnPreviewMouseMove"
                             AllowDrop="True" Drop="AnimationList_OnDrop"
                             DragOver="AnimationList_OnDragOver" DragLeave="AnimationList_OnDragLeave">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <!-- the drop line during a reorder drag, switched on one item at a time -->
                                <Setter Property="BorderBrush" Value="#2ECC40" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename..." Click="RenameAnimationMenuItem_OnClick" />
                                            <MenuItem Header="Delete" Click="DeleteAnimationMenuItem_OnClick" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                               ToolTip="Click to edit this animation. Drag to reorder: the FIRST animation's first frame is the picture a map draws. Right-click for Rename and Delete." />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,8,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding FrameHeader}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        <Button Content="Add frame" Width="84" Height="24" Margin="0,4,0,0" HorizontalAlignment="Left"
                                Command="{Binding AddFrameCommand}"
                                ToolTip="A new frame right after the selected one, copying its layout and its duration. Change one detail and that is the next phase." />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding HasFrameSelection}">
                            <TextBlock Text="hold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="40" Height="22" Text="{Binding FrameDuration, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Game frames this phase is held, 0-255, which is the animation's speed. 0 means it changes every frame. The only number in the exported table you type by hand." />
                        </StackPanel>
                    </StackPanel>

                    <ListBox x:Name="FrameList" Grid.Row="1" Grid.Column="1" Height="96" Margin="0,6,0,0"
                             BorderBrush="#999" BorderThickness="1" Background="#2A2A2A"
                             ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="FrameList_OnPreviewMouseLeftButtonDown"
                             PreviewMouseMove="FrameList_OnPreviewMouseMove"
                             AllowDrop="True" Drop="FrameList_OnDrop"
                             DragOver="FrameList_OnDragOver" DragLeave="FrameList_OnDragLeave">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="3,2" />
                                <Setter Property="BorderBrush" Value="#2ECC40" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="60" Background="Transparent" ToolTip="{Binding ToolTipText}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete" Click="DeleteFrameMenuItem_OnClick" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Image Source="{Binding Preview}" Height="52" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <TextBlock Text="{Binding Display}" FontSize="10" Foreground="#EEE" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- the sprite palette, below everything -->
            <DockPanel DockPanel.Dock="Bottom" Height="186" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Sprites: click one, then click a cell above. Right-click a cell to clear it." FontSize="11" Margin="0,0,0,4" />
                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding SpriteFolders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,4,0"
                                              Padding="8,2" MinHeight="24"
                                              ToolTip="Show this folder's sprites. Sub-folder sprites can be used in an object too: the layout is only a picture."
                                              Command="{Binding DataContext.SelectSpriteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border BorderBrush="#999" BorderThickness="1">
                    <ListBox ItemsSource="{Binding SpritePalette}" SelectedItem="{Binding SelectedPaletteSprite}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="64" Margin="2" ToolTip="{Binding Name}">
                                    <Image Source="{Binding Preview}" Width="44" Height="44" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- the rows: each with its own +/- cells, its own offset, and its cells drawn shifted by it -->
            <Border BorderBrush="#666" BorderThickness="1" Background="#222" Margin="0,4,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <!-- One bordered block, laid out as a table with fixed columns, so every
                                             row's controls line up with every other row's and none of it can
                                             grow into the cells beside it. -->
                                        <Border Width="186" Margin="0,0,8,0" Padding="6,4" CornerRadius="3"
                                                Background="#2E2E2E" BorderBrush="#555" BorderThickness="1" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" Foreground="#EEE" FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="+" Width="28" Height="24" FontSize="14" Padding="0" ToolTip="One more cell in this row"
                                                            Command="{Binding DataContext.AddCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="&#8211;" Width="28" Height="24" FontSize="14" Padding="0" Margin="4,0,0,0" ToolTip="One cell fewer in this row"
                                                            Command="{Binding DataContext.RemoveCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="&#10005;" Width="28" Height="24" FontSize="11" Padding="0" Margin="8,0,0,0" ToolTip="Remove this whole row"
                                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="dx" Foreground="#AAA" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,4,0,0" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Width="44" Height="22" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                         Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Pixels right, negative = left, of where the grid alone would put this row. -8 centres sprites under the row above." />
                                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="dy" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBox Width="44" Height="22" Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Pixels down, negative = up, of where the grid alone would put this row." />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- the cells themselves, shifted by the row's own offset so the layout shows the real shape -->
                                        <ItemsControl ItemsSource="{Binding Cells}" Margin="{Binding VisualMargin}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="56" Height="56" Padding="0" Background="#EEE" BorderBrush="#777" BorderThickness="1"
                                                            ToolTip="{Binding ToolTipText}"
                                                            Command="{Binding DataContext.PaintCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            MouseRightButtonUp="Cell_OnMouseRightButtonUp">
                                                        <Grid>
                                                            <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ row" Width="80" Height="26" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding AddRowCommand}" ToolTip="One more row under the last one, as wide as the widest row" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusText}" Style="{StaticResource EditorStatusTextStyle}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Width="80" IsCancel="True" Click="Close_OnClick" />
        </StackPanel>
    </Grid>
</Window>
