<Window x:Class="ZxNext.App.Views.ObjectTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ObjectTypesViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Object Types" Height="380" Width="320" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A7A1A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Object types are shared across every map (see the Help topic on map export) — used to categorize Sprite-layer objects, e.g. for a game's own trigger/behaviour logic." FontSize="10" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />

        <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1">
            <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name" BorderThickness="0" />
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Add" Width="70" Command="{Binding AddTypeCommand}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Rename" Width="70" Command="{Binding RenameTypeCommand}" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="Delete" Width="70" Command="{Binding DeleteTypeCommand}" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Content="Close" Width="80" HorizontalAlignment="Right" IsCancel="True" Click="Close_OnClick" />
        </Grid>
    </Grid>
</Window>
