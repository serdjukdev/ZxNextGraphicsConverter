<Window x:Class="ZxNext.App.Views.MapResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MapResizeViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Resize Map" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="AnchorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16" Width="320">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding NewWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Text="Height:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding NewHeight, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock Text="{Binding ValidationText}" FontSize="10" TextWrapping="Wrap" Foreground="Gray" MinHeight="14" Margin="0,0,0,10" />

        <TextBlock Text="Anchor (which corner of the current content stays put)" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
        <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="&#8598;" Command="{Binding SetAnchorCommand}" CommandParameter="TopLeft">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="TopLeft">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" Content="&#8593;" Command="{Binding SetAnchorCommand}" CommandParameter="TopCenter">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="TopCenter">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="0" Grid.Column="2" Content="&#8599;" Command="{Binding SetAnchorCommand}" CommandParameter="TopRight">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="TopRight">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Row="1" Grid.Column="0" Content="&#8592;" Command="{Binding SetAnchorCommand}" CommandParameter="MiddleLeft">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="MiddleLeft">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Content="&#8226;" Command="{Binding SetAnchorCommand}" CommandParameter="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="Center">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="1" Grid.Column="2" Content="&#8594;" Command="{Binding SetAnchorCommand}" CommandParameter="MiddleRight">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="MiddleRight">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Row="2" Grid.Column="0" Content="&#8601;" Command="{Binding SetAnchorCommand}" CommandParameter="BottomLeft">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="BottomLeft">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="2" Grid.Column="1" Content="&#8595;" Command="{Binding SetAnchorCommand}" CommandParameter="BottomCenter">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="BottomCenter">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Row="2" Grid.Column="2" Content="&#8600;" Command="{Binding SetAnchorCommand}" CommandParameter="BottomRight">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AnchorButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Anchor}" Value="BottomRight">
                                <Setter Property="Background" Value="#2A7FFF" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Text="{Binding DropWarningText}" FontSize="10" TextWrapping="Wrap" MinHeight="28" Margin="0,0,0,10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1A7A1A" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDrops}" Value="True">
                            <Setter Property="Foreground" Value="#B03030" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Apply" Width="90" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Apply_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
