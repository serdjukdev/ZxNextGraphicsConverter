<Window x:Class="ZxNext.App.Views.MapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        xmlns:local="clr-namespace:ZxNext.App"
        d:DataContext="{d:DesignInstance Type=vm:MapEditorViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Map Editor" Height="760" Width="1320" MinWidth="900" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="{x:Static local:Shortcuts.UndoKey}" Modifiers="{x:Static local:Shortcuts.UndoModifiers}" Command="{Binding UndoCommand}" />
        <KeyBinding Key="{x:Static local:Shortcuts.DeleteKey}" Command="{Binding DeleteSelectionCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ThumbnailListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE4FF" />
                    <Setter Property="BorderBrush" Value="#2A7FFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A7A1A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CanvasBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaintReady}" Value="True">
                    <Setter Property="BorderBrush" Value="#2ECC40" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootSplitGrid" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MapsColumn" Width="260" MinWidth="220" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition x:Name="LeftPaneColumn" Width="270" MinWidth="240" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition x:Name="RightPaneColumn" Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: existing maps -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="New Map..." Click="NewMap_OnClick" HorizontalAlignment="Left" Width="110" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Text="Existing maps" FontSize="11" Margin="0,0,0,2" />
            <Border Grid.Row="2" BorderBrush="#999" BorderThickness="1">
                <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Width="72" Background="Transparent" ToolTip="{Binding Name}">
                                <Border BorderBrush="#CCC" BorderThickness="1" Width="64" Height="64" HorizontalAlignment="Center">
                                    <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SizeLabel}" FontSize="8" Foreground="Gray" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Delete selected" Command="{Binding DeleteMapCommand}" Width="100" Margin="0,0,6,0" />
                <Button Content="Resize..." Click="ResizeMap_OnClick" Width="70" Margin="0,0,6,0" />
                <Button Content="Trim" Command="{Binding TrimCommand}" Width="60" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" MinHeight="16" Margin="0,8,0,0" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCC"
                      DragDelta="MapsSplitter_OnDragDelta" />

        <!-- Column 2: layers (selected row = active layer) + tool + palette -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Layers (top = front; selected row = active for painting/selection)" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" ItemsSource="{Binding LayerOrder}" SelectedItem="{Binding SelectedLayerRow}" Height="88">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsVisible}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Content="&#9650;" Width="28" Margin="0,0,0,4" Command="{Binding MoveLayerUpCommand}" ToolTip="Move this layer toward the front (drawn later, on top)" />
                    <Button Content="&#9660;" Width="28" Command="{Binding MoveLayerDownCommand}" ToolTip="Move this layer toward the back (drawn earlier, underneath)" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,6" Visibility="{Binding IsSpritesLayerActive, Converter={StaticResource BoolToVis}}">
                <Button Content="Manage Types..." Click="ManageTypes_OnClick" HorizontalAlignment="Left" />
            </Grid>

            <TextBlock Grid.Row="4" Margin="0,0,0,4" TextWrapping="Wrap"
                       Text="{Binding CanvasHintText}" Foreground="{Binding CanvasHintForeground}" />

            <!-- Metatile palette: grid layers -->
            <Border Grid.Row="5" BorderBrush="#999" BorderThickness="1" Visibility="{Binding IsGridLayerActive, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- GridSize=1 only: pick the orientation/palette slot to paint the currently-selected tile with. See MapEditorViewModel.PaintAttributes/RefreshPaintAttributes. -->
                    <StackPanel DockPanel.Dock="Top" Margin="4" Visibility="{Binding ShowPaintAttributes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Paint with:" FontSize="9" Foreground="Gray" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" DataContext="{Binding PaintAttributes}">
                            <CheckBox Content="Mirror X" IsChecked="{Binding MirrorX}" Margin="0,0,8,0" />
                            <CheckBox Content="Mirror Y" IsChecked="{Binding MirrorY}" Margin="0,0,8,0" />
                            <CheckBox Content="Rotate" IsChecked="{Binding Rotate}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" DataContext="{Binding PaintAttributes}"
                                    Visibility="{Binding CanOverridePalette, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NativePaletteSlotLabel}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding AvailablePaletteSlots}" SelectedItem="{Binding EffectivePaletteSlot}" Width="46" FontSize="9"
                                      ToolTip="Recolor: read this tile against a DIFFERENT palette slot than its own native one." />
                            <Button Content="&#8630;" Width="20" Margin="4,0,0,0" Command="{Binding ResetPaletteToNativeCommand}"
                                    Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Reset to the tile's own native palette slot" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding MetatilePalette}" SelectedItem="{Binding SelectedPaletteMetatile}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" Background="Transparent" ToolTip="{Binding Name}">
                                    <Image Source="{Binding Preview}" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="52" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Sprite palette: Sprite layer -->
            <Border Grid.Row="5" BorderBrush="#999" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridLayerActive}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListBox ItemsSource="{Binding SpritePalette}" SelectedItem="{Binding SelectedPaletteSprite}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource ThumbnailListBoxItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2" Background="Transparent" ToolTip="{Binding Name}">
                                <Image Source="{Binding Preview}" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="52" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Fill Selection" Command="{Binding FillSelectionCommand}" IsEnabled="{Binding CanFillSelection}" Width="100" Margin="0,0,6,0" />
                    <Button Content="Delete Selection" Command="{Binding DeleteSelectionCommand}" IsEnabled="{Binding HasSelection}" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{Binding LinkButtonText}" Command="{Binding ToggleLinkToolCommand}" IsEnabled="{Binding IsSpritesLayerActive}" Width="105" Margin="0,0,6,0" ToolTip="Link two objects: click one, then click the other.">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLinkToolActive}" Value="True">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Set Type" Command="{Binding ToggleSetTypeToolCommand}" IsEnabled="{Binding IsSpritesLayerActive}" Width="105" ToolTip="Click objects one after another to pick a type for each from a popup.">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetTypeToolActive}" Value="True">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Set User Byte" Command="{Binding ToggleSetUserByteToolCommand}" IsEnabled="{Binding IsSpritesLayerActive}" Width="105" Margin="0,0,6,0" ToolTip="Click objects one after another to edit each one's raw user byte.">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetUserByteToolActive}" Value="True">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Undo (Ctrl+Z)" Command="{Binding UndoCommand}" Width="110" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#CCC"
                      DragDelta="MainSplitter_OnDragDelta" />

        <!-- Column 4: the map canvas -->
        <DockPanel Grid.Column="4">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Canvas — click to place. Ctrl=erase, Shift=snap to grid, Alt=select/move (Alt+Shift=copy). Wheel=zoom, middle-drag=pan." />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridLayerActive}" Value="True">
                                    <Setter Property="Text" Value="Canvas — click or drag to paint. Ctrl=erase, Alt=select/move (Alt+Shift=copy). Wheel=zoom, middle-drag=pan." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <CheckBox Grid.Column="1" Content="Show grid" IsChecked="{Binding IsGridVisible}" VerticalAlignment="Center" />
            </Grid>
            <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="4,2" BorderBrush="#999" BorderThickness="1" Background="#F5F5F5">
                <TextBlock x:Name="CursorPositionText" FontFamily="Consolas" FontSize="11" Text="" />
            </Border>
            <Border Style="{StaticResource CanvasBorderStyle}" Background="#333">
                <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="MapScrollViewer_OnPreviewMouseWheel"
                              PreviewMouseDown="MapScrollViewer_OnPreviewMouseDown"
                              PreviewMouseMove="MapScrollViewer_OnPreviewMouseMove"
                              PreviewMouseUp="MapScrollViewer_OnPreviewMouseUp"
                              LostMouseCapture="MapScrollViewer_OnLostMouseCapture">
                    <Grid x:Name="MapCanvasHost" Background="Transparent"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          MouseLeftButtonDown="MapCanvasHost_OnMouseLeftButtonDown"
                          MouseMove="MapCanvasHost_OnMouseMove"
                          MouseLeftButtonUp="MapCanvasHost_OnMouseLeftButtonUp"
                          MouseRightButtonDown="MapCanvasHost_OnMouseRightButtonDown"
                          MouseRightButtonUp="MapCanvasHost_OnMouseRightButtonUp"
                          LostMouseCapture="MapCanvasHost_OnLostMouseCapture"
                          MouseLeave="MapCanvasHost_OnMouseLeave">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="MapZoomTransform" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Image x:Name="MapImage" Source="{Binding MapPreview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Canvas x:Name="GridOverlay" IsHitTestVisible="False" />
                        <Canvas x:Name="LinksOverlay" IsHitTestVisible="False" />
                        <Canvas x:Name="ObjectToolOverlay" IsHitTestVisible="False" />
                        <Canvas x:Name="HoverOverlay" IsHitTestVisible="False" />
                        <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Deliberately OUTSIDE the DockPanel/MapCanvasHost above: that Grid carries the zoom LayoutTransform
             (MapZoomTransform), which was bleeding into this Popup's content and rendering it at the current
             zoom scale (huge at high zoom) — Placement="Mouse" positions it from the live cursor position
             regardless of where it sits in the tree, so it doesn't need to be nested under the canvas at all. -->
        <Popup x:Name="SetTypePopup" Placement="Mouse" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#666" BorderThickness="1" Padding="2">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SetTypePopupItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Type.Name}" Click="SetTypePopupItem_OnClick" Tag="{Binding Type}"
                                        HorizontalContentAlignment="Left" Padding="8,3" Margin="0,1" MinWidth="90">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="#CCE4FF" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Same "outside the zoomed subtree, Placement=Mouse" fix as SetTypePopup above, and the same
             "StaysOpen=False dismisses itself on the triggering gesture's own pending mouse-up" gotcha —
             opened from MouseRightButtonUp (not Down), see MapCanvasHost_OnMouseRightButtonDown/Up. -->
        <Popup x:Name="ObjectActionPopup" Placement="Mouse" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#666" BorderThickness="1" Padding="2">
                <StackPanel>
                    <Button Content="Set User Byte" Click="ObjectActionPopup_SetUserByte_OnClick"
                            HorizontalContentAlignment="Left" Padding="8,3" Margin="0,1" MinWidth="110" />
                    <Button Content="Link" Click="ObjectActionPopup_Link_OnClick"
                            HorizontalContentAlignment="Left" Padding="8,3" Margin="0,1" MinWidth="110" />
                    <Button Content="Set Type" Click="ObjectActionPopup_SetType_OnClick"
                            HorizontalContentAlignment="Left" Padding="8,3" Margin="0,1" MinWidth="110" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
