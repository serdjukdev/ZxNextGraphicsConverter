<Window x:Class="ZxNext.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Help: Shortcuts &amp; Controls" Height="760" Width="820" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="TermStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DescStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="CodeBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BorderBrush" Value="#DDD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="SectionContentStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="10,4,4,12" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Margin="14,12,14,8" TextWrapping="Wrap"
                   Text="Every button, keyboard shortcut, and mouse interaction in this app, plus the exact data the export pipeline writes. Click a section to expand it." />
        <ScrollViewer Padding="14,0,14,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ================= 1. MAIN WINDOW & PROJECT TREE ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Main Window &amp; Project Tree" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource TermStyle}" Text="File → New Project... / Open Project..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Creates a new .zxngc project (in its own new subfolder) or opens an existing one. If the current project has unsaved changes, you're asked to save/discard/cancel first. A .zxngc records the app's project-format version: opening one made by a newer build, or one old enough to need a data migration on load (e.g. an early 8bpp sub-folder palette layout), still works and shows a one-time note about what was adjusted." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="File → Recent Projects" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="The last projects you opened or saved, most recent first." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Escape: close a window" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Closes any window other than the main one, the same as its Cancel or Close button (a dialog's Cancel discards its changes). Not while a dropdown, a popup or a drag is in progress: Escape closes that instead. The progress window of a running job ignores it." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+S: File → Save Project" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Saves in place. If the project has no location yet (shouldn't normally happen), use Save Project As... first." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="File → Save Project As..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Saves a copy at a new name/location directly (unlike New Project, this does NOT create a wrapping subfolder: you're relocating/renaming an existing project, not starting fresh)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="File → Import Images..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens a multi-select file picker and adds the chosen images to the Source Images panel. You can also just drag image files from Windows Explorer onto that panel, or click into the panel and press Ctrl+V to paste an image from the clipboard (screenshots, Snipping Tool, most image editors)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="File → Export for Next..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens the Export dialog: see the 'Export: what actually gets written' section below for the full data format." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="File → Settings..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="App-wide preferences (not saved with any project): export filename postfixes; 'Organise output into sub-folders matching the project tree' (off by default — when on, each asset category gets its own named sub-folder, user sub-folders nest inside it, and tilemap/8bpp grid+metatile files land in their tile-category folder; objects, map info and object types stay at the output root); 'Allow sub-folder assets in map/metatile editor' (off by default — when on, Sprite4Bpp/Sprite8Bpp sub-folder sprites appear in the Map Editor sprite palette and Tile8Bpp sub-folder tiles appear in the Metatile Editor tile palette; their export index is local to the sub-folder binary; turning it off while sub-folder placements exist removes them with a notification); 'Set ULA-over-tilemap bit (bit 0) on every exported Tilemap attribute byte' (off by default, writes 0 as before; on writes 1 instead — see 'Tilemap attribute byte, bit 0' below); 'Export all metatiles, not only the ones placed on the map' (the one option saved IN THE PROJECT, not app-wide; off by default: each layer's _metatiles file holds only the metatiles it places; on: it holds every metatile of that kind, and the grid's local indices count among all of them); the default dither mode for new imports; the default export chunk size and pixel order for a new row (pixel order only matters for software 8bpp Tile rows); New Map's and New Project's starting defaults; and the Map Editor's grid overlay colours. A second tab lists every shortcut/gesture in the app, grouped by area, with a tooltip on each row for the full explanation. OK saves immediately and takes effect the next time each default is used (no restart needed); Cancel discards." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+Z: Undo" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One shared undo stack for pixel painting and palette colour edits in the main window (a whole paint stroke: mouse-down to mouse-up: undoes as a single step, not one step per pixel). Cleared automatically after any operation that can remap a whole palette bank (re-quantize category/folder, Optimize bank, a delete that compacts slots): those aren't undoable, and always ask to confirm first." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Tools → Metatile Editor... / Object Editor... / Map Editor..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens the three dedicated editor windows: see their own sections below." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Thumbnail &amp; '[N]' prefix" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Every tile/sprite row shows a small thumbnail of its own actual pixels, and its real export index as a '[N]' prefix before the name: the exact number that ends up in the exported file. It is per FOLDER: a root-folder asset's '[N]' is what a map/metatile stores for it (and its s4_/s8_/... label); a sub-folder asset's '[N]' is its position within that sub-folder's own binary. Both update live: the thumbnail whenever that asset's pixels/palette change (including every OTHER tile/sprite sharing a palette slot/folder you just recoloured), the index whenever anything in that folder is added/removed/reordered." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Folder colours &amp; row layout" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Each folder row is a rounded chip, tinted by category type: green for the two 4bpp categories, blue for the two 8bpp, violet for the three Layer2 modes; a user sub-folder is a lighter shade of its parent's colour. Category roots show a short label ('Sprite 4bpp', 'Layer2 320x256'); sub-folder and asset names are truncated with an ellipsis, hover for the full name. The padlock (and, on Tile8Bpp rows, the priority arrow) sit in a fixed column at the right edge so they line up down the list. The left pane won't shrink below the width its content needs; drag its splitter to make it wider." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Drag a tile/sprite row to reorder or move it" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Drop on the top/bottom half of a target row to land before/after it, reassigning export indices to match. If the target row is in a DIFFERENT folder of a shared-palette category (Sprite4Bpp / Sprite8Bpp / Tile8Bpp: one palette across the whole category, so no re-quantize needed), the asset is also MOVED into that folder at that spot. You can also drop a row straight onto a folder to move it there (to the end). Moving a root sprite/tile that's currently placed on a map / used in a metatile INTO a sub-folder is refused with a message (a sub-folder asset can't be referenced), but moving anything into the root, or between sub-folders, is always fine. Layer2 (each sub-folder has its own palette) and Tile4Bpp (no sub-folders) reorder within one folder only. The reserved 'Blank' tile can never be dragged, or have anything dropped before it: it always stays first." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Project tree: selecting items" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click a tile/sprite = select it alone. Ctrl+click = add/remove it from a multi-selection. Shift+click = select the whole range between your last click and this one. Arrow keys always select a single item, same as a plain click. Clicking a folder/category never joins the multi-selection: it just shows that folder's palette overview on the right." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Double-click a folder" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Expands/collapses it. (Double-clicking a leaf tile/sprite does nothing special: every leaf click, single or rapid, is handled the same way, so quick Ctrl-clicking never gets mistaken for a double-click.)" />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Expand all' / 'Collapse all' buttons" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Above the tree: expands or collapses every folder at once." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Delete key (tree)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Deletes whatever's selected: a single tile/sprite, a whole checked multi-selection, or (if a user-created 8bpp sub-folder is selected) the folder and everything in it. Always confirms first; a folder/source-image delete explicitly warns how many placed tiles/sprites will go with it. A tile used in a metatile, or a sprite placed on a map, is no longer blocked outright: the confirmation instead spells out everything that goes with it (metatiles containing the tile, how many map cells will become the Blank tile, how many sprite placements will be removed) so you can decide. That cascade is not undoable; a plain delete with nothing else attached still is. A locked tile/sprite (see the padlock entry below) is always refused, and blocks deleting its folder or source image." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+R (tree)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Re-quantizes the selected tile/sprite: opens the Re-quantize dialog (choose a dithering mode) and re-converts it from its original source region." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a tile/sprite" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Rename..., Re-quantize... (Ctrl+R), Replace image... (see below), Delete, Lock / Unlock, and (on a Tile8Bpp tile) Priority / No priority. All except Replace image apply to the whole multi-selection if more than one is checked (Re-quantize is disabled for a mixed-category/folder selection); Replace image is always one asset at a time." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Replace image...' (right-click a tile/sprite/Layer2 image)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Gives this one asset a new picture without deleting it and importing a new one. It stays the same asset: same name, same export index (the number your own code has hardcoded), same lock, same position in the tree, and every metatile cell, map placement and animation target that uses it keeps working. Only its pixels and its palette colours change. The new picture comes from a source image in the project, chosen from the list on the left; 'Browse...' adds a file from disk to that list first, so the asset keeps a live source link and can still be re-quantized or re-dithered later. The asset also stops referencing its old source image, so once nothing else is made from that image, deleting it in the Source Images panel is a plain one-question delete. If the replacement's colours don't fit the palette you get the usual reduce-and-retry dialog. A whole metatile can be replaced the same way, from its own right-click menu in the Metatile Editor." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Aiming in the Replace Image window" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Three controls that never interfere with each other. Left click: jumps the selection to the whole cell under the cursor (for a Layer2 image, which has no cell grid, it positions the canvas exactly where you clicked). Arrow keys: move the selection one pixel at a time, and keep working whatever has the keyboard focus, including while the cursor sits in an offset box. 'Image offset' left/top: where the cell grid starts in this image, for a sheet with a border or one whose cells don't begin on a multiple of the tile size; it applies as you type, with no Enter needed, and Enter in those boxes just confirms the number instead of pressing Replace. The view is separate again: the window is resizable and opens showing the whole image, the mouse wheel zooms in whole-number steps around the pixel under the cursor (stopping at either end rather than jumping to the other extreme), and holding the middle mouse button drags the picture. A Layer2 source smaller than the canvas is padded with transparent, exactly as on import; a tile/sprite source smaller than the asset is refused with a message naming both sizes." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Priority arrow / Priority (Tile8Bpp only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Each Tile8Bpp row shows a small up-arrow: grey means normal, green means this whole tile is a Layer2 'priority' tile. Click it to toggle just that one, or use the right-click Priority / No priority item for a multi-selection. On real hardware a priority colour (bit 7 of the palette entry's second byte) draws on top of every layer, ignoring the usual sprite/layer/ULA order: use it for a foreground tile that must sit above sprites. Turning it on gives every non-transparent colour the tile uses a second, priority copy in the folder palette (shared with other priority tiles); transparent pixels are left alone. If the palette is too full you're offered a one-click optimize and retry. Only meaningful once you load that palette as the Layer2 palette (nextreg 0x43 = Layer2) in your own code. A priority tile is marked with a green corner in the palette strip and in the Metatile / Map Editor thumbnails (a metatile that contains one is marked too), and the Map Editor preview draws priority tiles on top of everything to match hardware (this is a preview aid only: the export is still one grid layer with one palette)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Padlock icon / Lock / Unlock (tree)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Every tile/sprite row shows a small padlock: open means it can be deleted, closed (amber) means it is locked. Click the padlock to toggle just that one, or use the right-click Lock / Unlock item for the whole multi-selection. A locked tile/sprite cannot be deleted by anything: not the Delete key, not deleting its folder or source image, not 'Delete unused', not the Metatile Editor's 1x1 delete. Use it to protect assets your game code references directly (animation frames, procedurally drawn tiles) that no map places. Locking does not affect reorder or export, and a locked asset still counts toward the 255-per-category limit." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Show in Map Editor' checkbox / menu item (Sprite4Bpp/Sprite8Bpp sub-folder only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A sub-folder sprite row shows a small checkbox next to its padlock: checked means this sprite also appears in the Map Editor's sprite palette alongside root sprites, so it can be placed on a map. Click it to toggle just that one, or use the right-click 'Show in Map Editor' / 'Hide from Map Editor' item for the whole multi-selection. Any number of sprites in one sub-folder can be checked at once, for example several different enemies' idle frames all sharing the same 16KB pattern bank, each independently placeable. It is a plain independent flag, not exclusive with sibling sprites in the same sub-folder. Purely a palette-curation choice: a placement's exported spriteIndex always resolves from that exact sprite's own local export index within its sub-folder, so checking or unchecking it later never changes already-exported map data." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Bank usage (status line, Sprite4Bpp/Sprite8Bpp)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Selecting a Sprite4Bpp or Sprite8Bpp category root, sub-folder, or any asset inside one appends that folder's bank usage to the status line: total packed bytes of every sprite directly in that folder versus the 16KB (16384 byte) shared sprite pattern memory pool real Next hardware splits between Sprite4Bpp and Sprite8Bpp. A guide for keeping one exported folder's binary within what the hardware can actually hold loaded at once." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a folder" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="'Add sub-folder...' (on every category root except Tile4Bpp, one level deep: Sprite4Bpp / Sprite8Bpp / Tile8Bpp sub-folders are 'banks' sharing the category's one palette; Layer2 sub-folders each get their own), 'Re-quantize folder...' (disabled if the folder has no tiles/sprites of its own), 'Delete folder...' (only on a user-created sub-folder, never a category root), 'Delete unused...' (see below; on a category root or a sub-folder, not on Layer2), 'Lock all in folder' / 'Unlock all in folder' (see below; on any folder including Layer2)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Lock all in folder' / 'Unlock all in folder' (right-click a folder)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Lock all: sets the delete-lock on every tile/sprite directly in this folder (category root = root-folder assets only, not sub-folder contents; sub-folder = that sub-folder's own assets). Unlock all: clears the lock on every tile/sprite in that same scope. A status line at the bottom of the main window shows how many were changed. Locked tiles/sprites are still exported and still count toward the category limit." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Delete unused...' (right-click a folder)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Deletes every tile/sprite in scope (the whole category for a category root, or just that one sub-folder otherwise) that no map places, directly or via any metatile, skipping locked ones. Shows the full list and a confirmation first. Note: 'not used in this project' is not the same as 'not used in your build': animation frames and procedurally drawn tiles are often referenced straight from game code, which this tool cannot see, so lock those first. Deleting also renumbers the '[N]' export index of every remaining tile/sprite in that category. Not undoable." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Drag &amp; drop: importing" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Drag image files from Explorer onto the Source Images panel to import them. Drag a row from the Source Images panel onto a category or sub-folder in the tree to place it: an exact-size match imports directly; a Layer2 folder that doesn't match opens a crop/position dialog; anything oversized opens the Atlas Slicer (see below). Any of these can hit a palette-overflow: see the Palette Overflow dialog below. (For dragging a tile/sprite row ONTO ANOTHER one to reorder it, see the entry above.)" />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Source Images panel" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click a row to see the whole picture in the big preview on the right, as large as the preview area allows, with its file name, size and how many assets are made from it; the selected asset, pixel editor and palette stay as they are, and a click in the project tree or the pixel editor brings the asset back. The eyedropper does not work on a source preview. Each row shows a thumbnail, filename and size. The small '✕' button (or Delete key on a selected row) removes that source image: and, if it was ever used, every tile/sprite placed from it too, after an explicit confirmation naming the count. Ctrl+V pastes an image from the clipboard as a new source image, named clipboard_&lt;timestamp&gt;. If the clipboard image carried no transparency (alpha) data (some apps' copy, including some Photoshop versions), a warning says so and the image is pasted fully opaque. Some of those same apps also crop away any transparent border before putting the image on the clipboard, so a selection with a transparent margin can arrive smaller than it was (e.g. a 32x32 selection with a 2px margin arrives as 28x28) — export or save the image as a PNG file and import that instead if it needs transparency or its exact original size." />
                    </StackPanel>
                </Expander>

                <!-- ================= 2. PIXEL & PALETTE EDITOR ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Pixel &amp; Palette Editor" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource TermStyle}" Text="Click / drag to paint" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Pick a palette colour first (click a swatch below): painting is disabled with a reminder message until you do. The pixel editor renders at a fixed 16x zoom. A whole click-drag-release stroke is one undo step." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+click/drag (bottom) or plain click/drag (top): eyedropper" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="In the editable pixel editor (bottom), Ctrl is required since a plain click there paints. In the read-only preview (top), nothing else happens on click, so no modifier is needed: click or drag across it to sweep the eyedropper. Either way it picks the colour under the cursor and selects/highlights that palette swatch." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Palette strip: click a swatch" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Selects it as the current paint colour. A small green corner on a swatch marks a Layer2 priority colour (Tile8Bpp folders only: see the Priority arrow in the Project Tree section); its colour can still be edited like any other." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Palette strip: double-click a swatch" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens the colour picker (the real, complete 512-colour Next palette: 8 blocks of 8x8 swatches: so you can never pick an invalid colour). Changes that slot's colour everywhere it's used, live, and pushes one undo step. Blocked on the transparent-index slot (nothing to recolour there)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="4bpp palette-bank overview (16 rows)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Selecting a 4bpp tile/sprite shows all 16 bank slots at once, with your item's own slot highlighted and clickable (the others are read-only previews: clicking them does nothing, so you can't accidentally repaint a different tile's colours). Selecting a 4bpp category root itself shows all 16 with none highlighted, plus a usage summary." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Optimize bank...' button (4bpp only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Repacks the whole palette bank to use as few of the 16 slots as possible by regrouping tiles/sprites that share (or nearly share) a colour set: colours themselves never change, only which slot each tile/sprite reads from. All-or-nothing (nothing changes if any tile can't be placed) and NOT undoable: confirms first." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Status line" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Shows the selected colour's RGB hex, its 9-bit Next value (decimal and binary), and: for a 4bpp tile/sprite: which palette number and slot it is." />
                    </StackPanel>
                </Expander>

                <!-- ================= 3. ATLAS SLICER ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Atlas Slicer" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens automatically when you place an image that's larger than one cell (and isn't a Layer2 image): it needs to be cut into individual tiles/sprites first." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="Offset left / Offset top / Spacing" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Where the grid of cells starts and how many pixels sit between cells: the red-line preview and the 'Cells found: N' count update live as you type." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="'Skip duplicate cells' checkbox (on by default)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Cells with byte-identical raw pixels (checked before any colour conversion) are imported only once: the final status line reports how many were skipped." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="'Slice into metatile blocks' checkbox (Tile4Bpp/Tile8Bpp only, not offered in a 1x1 project)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Cuts the atlas into NxN-tile blocks (N = this project's fixed metatile size: 16x16/32x32 pixels) instead of individual 8x8 tiles. Each block is split into its own 8x8 tiles (duplicates within this same slicing pass are reused, same as 'Skip duplicate cells'), and a metatile is auto-created from the result: one metatile per block — UNLESS the block's resulting tile composition (same tiles, same order) exactly matches a metatile already created earlier in this same slice, in which case that existing metatile is reused instead of creating an identical duplicate. A block where any of its tiles fails to import (e.g. palette overflow) is skipped entirely rather than creating a metatile with a missing cell. Not offered at all in a 1x1 project: a 1x1 'block' is just a plain tile, and every plain-sliced tile already gets its own metatile automatically there (see below)." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="'Place the transparent tile first' checkbox" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Only shown when this slice includes a fully transparent cell AND the target category doesn't already have one: moves that tile to the front of the category's export order (index 0) so a game programmer can find it without paging through the rest, e.g. as a 'walk-through' tile. Off screen (not shown) if either condition doesn't hold." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="Click a cell/block in the preview" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Toggles it in or out of the conversion: green means it'll be converted, red (with a dimmed wash) means it won't. Always available, for every category, even when nothing is close to any limit. Excluding everything is fine: Slice &amp; Import then just converts nothing." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="'Select all that fit' / 'Clear selection' buttons" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="'Select all that fit' keeps whatever you've already picked and fills in the rest, top to bottom, up to whatever capacity remains. 'Clear selection' turns everything off." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="Tile4Bpp's 256-tile limit and the 255-metatile-per-Kind limit" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Tile4Bpp is hard-capped at 256 tiles total in the category: the real hardware tilemap's 8-bit tile index (Tile8Bpp, a software layer, has no such cap). In 'Slice into metatile blocks' mode, a separate 255-per-Kind metatile cap also applies, to both Tile4Bpp and Tile8Bpp. Whenever a limit is actually in play, the default selection fills top-down within it (a status line under the preview shows how many slots are left), and clicking a cell/block ON is refused: with an explanation, not silently: if it would push either count over the limit; turning one off always works. Fully transparent cells/blocks never count against either limit (they reuse the project's single reserved Blank tile/metatile instead of creating a new one) and are never auto-selected by default, but can still be clicked on by hand for free. A block whose tile composition exactly duplicates an earlier block's (see 'Slice into metatile blocks' above) likewise costs no metatile slot, so the default selection can include more blocks than the raw count suggests." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="Slice &amp; Import" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Converts every INCLUDED cell/block through the normal import pipeline (runs in the background with a progress bar); reports how many imported, failed (palette overflow), skipped as duplicates, and excluded by selection." />
                    </StackPanel>
                </Expander>

                <!-- ================= 4. OBJECT EDITOR ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Object Editor (Tools &#8594; Object Editor...)" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource DescStyle}" Text="An object is a named group of SPRITES that the Map Editor can place as one unit and draw whole: a 5-wide platform, a character of one sprite over two. It exists so a map shows what is actually on it instead of a lone sprite standing in for something bigger. Objects are entirely optional: with none defined, the Map Editor behaves exactly as it always did and you place single sprites." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="What is and is not exported" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A map&apos;s own object record never carries the layout: your code decides which sprites a placed object really uses, from its type and user byte, exactly as before objects existed. What that record takes from an object is what its picture measures, written into its extended bytes (see the export section&apos;s &apos;Extended object bytes&apos;) instead of numbers typed on the object type; precedence is values pinned on the placement itself, then its object, then its type, then the sprite&apos;s own size. The layout itself is exported in ONE place and one shape: each animation of the object becomes a table in object_anims.asm, sprite by sprite with their offsets and palettes, which is what a drawing routine actually needs." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Rows, not a rectangle" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="An object is a list of rows, each with its own number of cells and its own pixel offset, because real sprite compositions are not rectangular: a character is one sprite on top and two below. Each row's block holds its number, '+' and '-' for its cell count, '&#10005;' to remove the row, and dx/dy in pixels; '+ row' at the bottom adds another, as wide as the widest row so far. The last row and a row's last cell cannot be removed. dx -8 is the usual value: it centres a row of sprites under the row above. Negative offsets never push a row off the left/top of the editor, the whole object is simply drawn from its own leftmost edge instead, so the cells always show the real shape." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Painting cells" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click a sprite in the palette at the bottom, then click a cell. Right-click a cell to clear it. The same sprite can fill as many cells as you like, which is how a platform repeats its centre piece. Above the palette is a strip of folder buttons: a sprite category's root, then each of its sub-folders. Sub-folder sprites can be used in an object freely, unlike map placements, because the layout is only a picture and needs no global export index. Each folder lists its sprites in their real project order (the Project Tree's order, which is also the export's), not alphabetically." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Type, subtype and user byte" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="The type and the whole user byte every NEW placement of this object starts with. A placement takes a COPY of both when you place it and owns it from then on, which is what lets 'Set User Byte' give one enemy on the map its own value; editing the object here therefore does not reach objects already placed, and their right-click menu on the map still shows their own byte. Change those on the map, or delete and re-place them. The user byte is edited in place three ways at once, all on the same byte: the number, the eight bit buttons (each labelled with its value, and with the name of the subtype that owns it underneath, when one does), and the Subtype picker, which sets its own bit and clears the other subtypes' bits while leaving every other bit alone. That is what lets one byte carry a named variant and a hand-entered parameter together, like a platform's kind in the upper bits and its size in the lower ones." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Exported size px / 'from the picture'" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Ticked (the default): the exported width/height is whatever the sprites measure, offsets included. Unticked: the two numbers are used instead. That matters because the exported size is what a game treats as the object's box, which is often not the picture's extent: a 32x32 picture of a character whose body is one sprite wide wants 16x32. These two numbers ARE the hitbox's size: the Hitbox window beside them edits the same pair, and dragging a side there unticks this." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Hitbox..." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens the object's COLLISION BOX drawn over its own art, at whatever zoom fits the window, so it is set with the mouse rather than by counting pixels: drag inside the box to move it, drag one of its eight handles (four sides, four corners) to resize it, or type the four numbers under the picture. X and Y are pixels from the ANCHOR sprite's top-left pixel (the frame's first sprite in reading order, the one with no offset in the animation table) and may be negative; W and H are the object's exported width and height, which is why there is no second pair of size fields. 'Whole picture' puts it back to the default: box at the anchor, as big as the picture, and the size following the picture again. Nothing here is measured or auto-fitted, and an object whose box nobody touched exports exactly what it always did. Why it matters: the engine knows an object as X, Y, width and height and nothing else, so a map placement exports the BOX's corner as its X/Y and the record's drawX/drawY (minus this offset) lead back to where the picture is drawn. The box may hang off the picture or be bigger than it; further than 127 px from the anchor is refused at export, since drawX/drawY is one signed byte." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Animations and frames" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="An object holds named ANIMATIONS, and each animation is a list of FRAMES. A frame is one row layout (the editor below) plus how long it is held, so the rows, cells and offsets you edit always belong to the SELECTED frame. A still object is simply a one-frame animation, which is why there is no separate mode for one. The animation strip is the upper row: &apos;Add...&apos; asks for a name, an animation&apos;s own right-click menu has Rename and Delete, and dragging reorders them. Order matters for the first one: the FIRST animation&apos;s first frame is the picture a map draws for a placed object." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="The frame strip" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Thumbnails of the selected animation&apos;s frames, numbered from 0. Click one to load it into the row editor below. &apos;Add frame&apos; inserts a frame right after the selected one, copying its layout and its duration, since the next phase of an animation usually differs from the one before it by a detail. Right-click a frame to delete it (the last frame of an animation is kept), and drag to reorder: frame order IS play order. The &apos;hold&apos; box is that frame&apos;s duration in game frames, 0-255, which is the animation&apos;s speed; 0 means it changes every game frame. Flipping through the frames is the preview: there is no playback here, since what the speed looks like is a question for the real machine." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="The Types tab" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="The second tab on the left holds the project's object TYPES and their subtypes, which used to be the Map Editor's 'Manage Types...' dialog. A type is exported data, not map data: the object record's type byte, the obj_&lt;name&gt; numbers in object_types.asm, each map's per-type counts, and the init order those numbers give. Each row therefore shows the export number the type currently has, which is simply its position: drag a type to another place and its number (and the init order of its objects) changes with it. 'Add...' asks for a name; Rename and Delete are on the type's right-click menu, and a delete is refused while any object or placement still uses the type. Under the list are that type's width/height defaults, which only matter for a placement that has this type but no object of its own, and the type's subtype list with its own 'Add...', right-click menu and bit picker. A type carries no palette number: a sprite's palette travels with the sprite, in the object's animation table." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="The object list" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="'Add...' asks for a name and creates the object; Rename and Delete are on an object's own right-click menu. Drag an object onto another to reorder the list (a green line shows where it will land). Deleting an object never touches a map: every placement made from it stays where it is and keeps its own sprite, type and user byte, since a placement stores those itself. It simply goes back to drawing as that single sprite." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Palette line" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="The palette slot of the object's first filled cell, shown for information. Mixing slots inside one object is allowed: each sprite carries its own palette in the exported animation table, so a frame may use several slots at once. The red line below it is about something else: a sprite taken from a SUB-FOLDER has a pattern number local to that sub-folder's own binary, so a table built from one only works while that bank is loaded." />
                    </StackPanel>
                </Expander>

                <!-- ================= 5. METATILE EDITOR ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Metatile Editor (Tools → Metatile Editor...)" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource DescStyle}" Text="A metatile is a small square of individual tiles treated as one stamp on the Map Editor's grid layers. Every change here writes straight into the project immediately: there's no separate save inside this window, only File → Save Project in the main window later." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Metatile size (1x1 / 2x2 / 4x4)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One fixed size for the WHOLE project: every metatile of either Kind, and every map's grid, shares it. Asked once, in the New Project dialog when the project is created. Fixed forever afterward; there is no per-metatile or per-map size choice anymore. 1x1 is a special 'no metatile' mode: every Tile4Bpp/Tile8Bpp tile automatically gets its own 1-cell metatile the moment it's imported, so this editor never needs to be opened at all: the Map Editor's palette already shows one paintable entry per tile, and its own 'Paint with' panel/right-click popup handle mirror/rotate/palette-slot instead (see the Map Editor section below). Note its Tilemap layer's grid file is 2 bytes/cell (not 1), so a 1x1 map's cell-count limit is half of a 2x2/4x4 map's." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Kind: 4bpp / 8bpp" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Which tile category this metatile draws from: 4bpp metatiles feed the hardware Tilemap layer (with real mirror/rotate/palette-slot hardware attributes); 8bpp metatiles feed the software 8bpp Tile layer (index only, no attributes)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Tile palette (left) → click to arm it" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click a tile thumbnail, then click a cell in the draft grid on the right to stamp that tile into it. An unfilled cell shows a grey '+' placeholder. Ctrl+click a cell to clear it back to unfilled, to correct a mistake. You can also drag a tile straight from the palette onto a cell instead of the click-click sequence: both work interchangeably, cell by cell." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Green corner marker (8bpp only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A small green corner on a tile thumbnail, a draft cell, or an existing-metatile thumbnail means that tile is a Layer2 'priority' tile: it draws on top of every layer on hardware. It's set/cleared in the Project Tree (the green up-arrow on a Tile8Bpp row), not here. A metatile is marked if any of its cells is a priority tile. The Map Editor preview draws priority tiles on top to match hardware, but the export is unchanged." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Per-cell controls (4bpp metatiles only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Mirror X, Mirror Y, Rotate (transposes the tile: combined with the two mirrors this reaches all 8 possible orientations, since the hardware has no separate 90/180/270° rotation), and an optional palette-slot override (read this cell's tile against a different bank slot than its own, with a '↺' button to reset back to native)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Name + 'Create Metatile' / 'Save Changes' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Requires every cell filled first: every cell needs a real tile (a transparent one if a gap should show through, since the hardware always draws SOMETHING at each cell). Names are auto-uniquified (_2, _3...) if already taken. Capped at 255 metatiles per Kind: one of those slots is always that Kind's own auto-generated, undeletable 'Blank' reserved metatile (see the Map Editor entry below), so real metatiles effectively get up to 254." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Existing metatiles list (left) → click one to edit it" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Loads it into the draft on the right: the button becomes 'Save Changes' and writes back into that SAME metatile (its Id/Kind/GridSize/export position never change, so every map already placing it just picks up the new cells immediately). Click 'New' to abandon the edit and start a brand-new metatile instead." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a metatile → 'Rename... (F2)'" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Renames just that metatile, without loading it into the draft or needing every cell filled: the direct route, instead of selecting it, retyping the Name and clicking 'Save Changes' (which still works). F2 does the same for whichever single metatile is selected in the list. A name already used by another metatile is refused outright here, with the dialog saying so, rather than auto-uniquified the way Create/Save Changes does it: an explicit rename shouldn't quietly store something else. On a 1x1 project the metatile is just a wrapper around one tile, so this renames that tile too (and the Project Tree updates to match) — names are ASM export labels, and letting the two drift apart for what is really one thing would be confusing. The reserved 'Blank' metatile can't be renamed." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a metatile &#8594; 'Replace image...'" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Gives the whole metatile a new picture. You pick a source image and a region the size of the metatile's own footprint (8x8 per cell, so 16x16 for a 2x2 metatile), and each 8x8 piece replaces that cell's TILE in place: the metatile keeps its name, its export index (the byte every map grid cell stores for it) and every placement on every map, and so does each tile. A confirmation lists exactly what will happen first, because three cases are not obvious. One tile used by two cells of the same metatile cannot show two different pictures: the first cell replaces the shared tile and each later cell gets a new tile, appended at the end so no existing tile's export index moves. A cell showing the reserved 'Blank' tile is never allowed to overwrite it (every empty map cell in the project points at that one tile): it gets its own new tile instead, unless its new piece is fully transparent too, in which case the cell is simply left blank. And a cell's Mirror/Rotate flags are cleared, since the new piece is written the right way round rather than being flipped by hardware. The confirmation also names every OTHER metatile built from the tiles being replaced, since those change along with them. Colours are re-converted from scratch, so a 4bpp tile can end up in a different palette slot than before; a tile whose colours don't fit its palette goes through the usual reduce-and-retry dialog while the other cells still go through. Not undoable. Disabled on the reserved 'Blank' metatile, which has no picture of its own." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Drag a metatile onto another to reorder" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Drop on the left/right half of the target to land before/after it. Reassigns real export indices AND rewrites every map cell that placed one of the affected metatiles under its old index: unlike a tile/sprite's index, a metatile's is the literal byte stored in map data, so every map using it stays correct automatically. The reserved 'Blank' metatile can never be dragged, or have anything dropped before it: it always stays first." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+click / Shift+click a metatile → multi-select" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Same multi-select as the Project Tree: Ctrl+click adds/removes one, Shift+click selects the range since your last click. 'Delete selected' then deletes every selected metatile, with one confirmation for the group." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Delete selected' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Deletes whatever's currently selected in the list above. For a single metatile still placed on a map, asks to confirm first: naming exactly which map and how many cells will become the Blank tile, instead of blocking outright; selecting more than one instead just confirms the count. Neither is undoable. Deletes and re-compacts every other metatile of the same Kind to a dense index, remapping every map that used them. The reserved 'Blank' metatile itself is still always undeletable. On a 1x1 project, a metatile is just a wrapper around one tile, so this deletes that tile too (same as deleting it from the Project Tree would) — otherwise the tile would be left behind, unplaceable on any map." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Delete Unused' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Deletes every metatile of the current Kind that no map places, with one confirmation for the whole group instead of one per metatile. A no-op with a status message if nothing qualifies. Same 1x1 behaviour as 'Delete selected': deletes the underlying tile, not just the metatile wrapper. On a 1x1 project a metatile whose tile is locked in the Project Tree is skipped. To sweep unused tiles/sprites project-wide from the tree itself, use its right-click 'Delete unused...'." />
                    </StackPanel>
                </Expander>

                <!-- ================= 5. MAP EDITOR ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Map Editor (Tools → Map Editor...)" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource DescStyle}" Text="A map has 3 layers sharing the same size: a 4bpp Tilemap grid, an 8bpp Tile grid, and a freeform Sprite layer: painted with metatiles/sprites from the side palette. The selected row in the Layers list is both the front-to-back display order AND which layer painting/selection targets. Only root-folder sprites appear in the Sprite palette: a user sub-folder is a separate 'bank' the object system can't address (same as sub-folder tiles being kept out of the Metatile Editor)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Reopening the editor / switching maps" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="The editor reopens on whichever map you last had selected. Each individual map also remembers its own scroll position, zoom, and active layer as you leave it (switching to another map, or closing the window) and restores them the next time you come back to that particular map." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Tools: Brush / Fill / Select" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Three buttons under the palette pick what a left click on the canvas does. Exactly one tool is on at a time (it is drawn highlighted), and picking one switches the previous one off; Link, Set Type and Set User Byte on the Sprite layer belong to the same group. Brush is the default." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Brush" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click or drag to paint with whichever metatile, template or object is picked in the palette. Sprite and template placement is click-only (no drag-stamping). Brush paints cell by cell and has no selection: switching to it, or painting with it, drops any selection." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Fill (grid layers only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click a cell: every cell connected to it (left, right, up, down) holding the same metatile is filled with the picked one, like a paint bucket; on a 1x1 map's Tilemap layer the mirror/rotate/palette byte must match too, and the 'Paint with' panel's values are written. Drag instead: the rectangle you drag out is selected and filled when you let go. While an area is selected, picking another metatile in the palette refills it at once, so you can try several. A click inside the selection fills the connected area only inside it; a click outside drops the selection and fills on the whole map. Ctrl fills with blank instead. Each fill is one undo step." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Select" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Drag on empty space (or outside the current selection) to draw a new selection box (cell-rectangle on a grid layer, or every sprite whose box touches yours on the Sprite layer). Drag from INSIDE the current selection instead to move it; hold Shift when you let go to copy instead of moving. Whatever you drag past the map's edge is dropped, not pushed back in: grid cells beyond the edge are lost, and an object whose top-left corner ends up outside the map is deleted, with the status line saying how many. One Ctrl+Z undoes the whole move, deletions included." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+click/drag" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="With the Brush, force-erases on the active layer, including mid-drag. With Fill, fills with blank." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Alt+click: eyedropper" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="With any tool, picks what is under the cursor into the palette and changes nothing on the map. On a grid layer it selects that cell's metatile (switching the palette to Metatiles); on a 1x1 map's Tilemap layer it also copies the cell's mirror/rotate/palette into 'Paint with'. On the Sprite layer it selects the object the clicked placement was made from, or its plain sprite. With Fill and a selected area, picking does not refill the area." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Shift (placing a sprite)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Snaps the new sprite's position to the faint 8x8 tile grid: a green preview box follows the cursor while held." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Delete key / 'Delete Selection' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Clears the current selection's contents: grid cells become empty, selected sprites are removed." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Fill Selection' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Stamps the currently-selected palette metatile across every cell of the grid selection, as one undo step. On a GridSize=1 map's Tilemap layer this also picks up whatever the 'Paint with' panel is currently set to, same as a plain paint stroke." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Metatiles' / 'Templates' toggle" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Switches the side palette between individual metatiles and saved Templates, on a grid layer only. A Template only ever appears while its own Kind (Tilemap or 8bpp) and the open map's metatile size match, so it can never be picked for the wrong layer." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Save as Template...' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Enabled whenever there is an active grid selection (make one with the Select tool). Opens a small dialog to name the block, then stores it as a new Template: graphics only, no map objects. Stored project-wide, so the same Template can be stamped onto any map that shares its Kind and metatile size. Not undoable (same as deleting a map)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Placing a Template (stamp)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Pick a Template in the palette: a translucent blue footprint the size of the Template follows the cursor over the canvas. Click to write the whole block at that position as one undo step, same as a normal paint stroke. Click-only, like sprite placement: dragging does not repeat-stamp it. A Template that does not fully fit at the clicked position is clipped silently at the map's edge rather than refused." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a Template: Rename... / Delete" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Rename asks for a new name, which no other Template may already have. Delete removes the Template after a confirmation. Neither is undoable. Deleting has no effect on cells already stamped from it elsewhere, since stamping copies the block's bytes rather than keeping a live reference." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Paint with' panel (Tilemap layer, GridSize=1 only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Mirror X / Mirror Y / Rotate checkboxes plus a palette-slot picker for whichever tile is selected in the palette below: painting/Fill Selection uses this combination instead of the tile's plain default orientation. Resets to unmirrored/native-palette every time the palette selection changes: it never silently carries over from a previously picked tile. Which tile gets painted (the metatile index) and its attribute (mirror/rotate/palette) are stored completely separately, so using this never creates a new metatile and can never run into the 255-per-Kind metatile cap. Not shown for 2x2/4x4 maps (their metatiles carry their own baked-in per-cell attributes, set in the Metatile Editor) or the 8bpp layer (no attribute concept)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Mouse wheel / middle-drag" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Zooms in/out (25%-800%, stays anchored under the cursor) / pans the view." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Show grid' checkbox" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Toggles a faint 8x8 tile grid plus a brighter metatile-size grid, shared by all layers. This is a per-session preference, not saved with the map or project." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Cursor position readout (under the canvas)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Shows the cursor's raw map pixel X/Y, plus its tile cell (col,row) in the 8x8 tile grid, live as you move over the canvas. On a 2x2/4x4 map it also shows the metatile cell (col,row); on a 1x1 map there is no separate metatile concept, so only Tile is shown. Clears when the cursor leaves the canvas." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Resize...' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens a dialog: new Width/Height plus a 3x3 anchor (which corner/edge of the current content stays put): shows exactly how many tilemap cells, 8bpp cells, and sprites would be dropped before you apply. Shrinking the map really does remove the objects in the cut-away area (they are never kept off-map, where you could not see or select them but the export would still write them out); an object only partly over the new edge, with its top-left corner still inside, is kept. Any Link pointing at a removed object is cleared. One Undo step brings the whole resize, dropped objects included, back." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Trim' button" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Auto-crops the map to the tightest box containing any real content, considering BOTH grid layers together plus every sprite's footprint (never just whichever layer happens to be selected): never drops anything by construction. No-ops with a message if the map is completely empty." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Palette tabs: 'objects' / 'root' (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Two tabs above the palette. 'objects' lists the project's named objects (built in Tools &#8594; Object Editor), each shown by its whole picture; it is the default whenever any object exists. 'root' is the original palette of single root-folder sprites. Both place onto the Sprite layer with a plain click, and both snap to the 8x8 tile grid while Shift is held. Switching tabs drops whatever the other tab had armed, so a click can never place something you cannot see. With no objects defined, the objects tab says so and the palette behaves exactly as it always did." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Placing an object (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A placed object is drawn in full on the map: every sprite of every row, with each row's own pixel offset, so it looks like what it is. It brings its object's type and user byte with it (both still editable per placement afterwards), and it writes that object's measured width, height and palette into its extended bytes at export, which beats the numbers set on the object type. Everything that acts on a placement uses its REAL area, not the 16x16 of its base sprite: the click that selects or erases it, the Alt-drag marquee, the red Ctrl-erase preview, the green Shift-snap preview and the selection outline. An object with no sprites in it yet cannot be placed, and says so: a placement has to carry a real sprite for the exported spriteIndex. Deleting an object in the Object Editor leaves its placements alone, drawing as that single base sprite." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Sprite palette: hover tooltip (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Hovering over a sprite in the palette shows a tooltip with its name and how many objects of that type are currently placed on this map, so you can quickly check which sprites are used and how often." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Object types (moved to the Object Editor)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Object types live on the Object Editor's Types tab now (Tools &#8594; Object Editor), not in a dialog of their own: a type is project-wide exported data rather than map data, and that window is where a type is already picked for an object. They are project-wide categories (e.g. 'portal', 'character') for map objects: not visual, just an ID a game's own code can check. Their LIST ORDER is the type's exported equ number and the init order of its objects within every map's exported object list, which is why each row shows its current number and why dragging one changes it. Deleting a type is refused while any object or placement still uses it. To assign a type to a placed object here in the Map Editor, use the 'Set Type' button below. The selected type also carries the object data every object of that type exports: a palette number 0-15 and a width and height in pixels (16x16 by default). Those reach the binary only while 'Extended object bytes' is on in Settings, and any single object can pin its own values instead (see 'Object Data...' below). Below that, the selected type can also be given named SUBTYPES: see the next entry." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Subtypes (Object Editor &#8594; Types tab)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A name for one bit of a placed object's user byte, belonging to one object type: 'moving', 'falling', and so on. Edited on the Object Editor's Types tab, under the selected type. At most 8 per type, since a byte has 8 bits. 'Add...' takes the lowest free bit; the bit picker beside it moves the selected subtype to another, refusing a bit a sibling subtype of the same type already owns (it names the owner). A subtype's name must be unique across the WHOLE project, not just its own type, because the exported label carries no type name: object_types.asm gets subobj_&lt;name&gt;: equ &lt;bit value&gt;, and the value is the BIT'S VALUE (1, 2, 4, 8, ...) rather than its index, so game code tests it with a plain AND. Subtypes are optional: a type with none behaves exactly as before. Deleting one does not touch any placed object's user byte, since that byte is raw game data you may also be setting by hand." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click an object &#8594; 'Object Data...'" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Width and height in pixels for this one object: the extended bytes 8-9 of its exported record. Each has an 'inherited' tick. Ticked (the default) means the value is taken from the named object this was placed from, or from its object type, or from the sprite's own size, in that order, so changing the object or the type later moves this placement with it; unticked pins the number on this placement alone. The box always shows the number that will actually be exported, and the line at the top of the dialog names where an inherited number came from. An object sized by hand in the Object Editor (48x8 for a platform, say) therefore shows 48x8 here, not its type's default. Right-clicking an active selection (Alt+drag a box first) applies whatever you set to EVERY selected object at once, as one Undo step. These bytes reach the binary only while 'Extended object bytes' is on in Settings; the values are stored in the project either way. There is no palette field: a sprite's palette is exported with the sprite itself, in the object's animation table." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Set Type' button (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click the button (requires at least one object type to already exist): every object on the map gets a gray outline. Click any object: a small popup lists the available types, click one to apply it and close the popup. The tool stays armed, so you can keep clicking through several objects in a row; click the button again to stop. Right-click an object directly for the same effect on just that one object, without arming the tool from the toolbar: a one-time action, nothing stays armed afterward. To set ONE type on MANY objects at once instead, make a selection first (Alt+drag a box) and right-click: see 'Right-click with an active selection' below." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Set User Byte' button (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click the button: every object on the map gets a gray outline. Click any object: a small dialog opens with its raw user byte (0-255, exported as the object's 8th byte), shown as both a number and its 8 individual bits, either one edits the other. If the object's type has named subtypes (see 'Manage Types...'), they are listed below too: picking one sets its own bit and clears the other subtype bits, while bits no subtype owns keep whatever the number or the bit buttons gave them, so one byte can hold a named variant and a hand-entered parameter at the same time. OK applies and closes the dialog, Cancel discards. The tool stays armed, so you can keep clicking through several objects in a row; click the button again to stop. Right-click an object directly for the same effect on just that one object, without arming the tool from the toolbar: a one-time action, nothing stays armed afterward. To set ONE value on MANY objects at once instead, make a selection first (Alt+drag a box) and right-click: see 'Right-click with an active selection' below." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="'Link' button (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Click the button (now labeled 'Click A'): every object on the map gets a gray outline to show it's clickable. Click the first object: it turns green and the button switches to 'Click B'. Click a different object: a cyan arrow (pointing at the second object) records that the first links to the second, e.g. a button that opens a specific door, and all outlines clear. Deleting either object removes the link. If two objects link to each other, both arrows are drawn slightly apart so both stay visible. Right-clicking an object jumps straight to 'Click B' for it (pre-selects it as the first object, skipping a separate arm-then-click step): still needs one more click on a different object to finish, exactly as above." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click an object (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Shows a small menu: Set User Byte (the number, its 8 bits, and the object type's named subtypes) / Link / Set Type / Object Data...: for whichever object you right-clicked, without needing to arm anything from the toolbar first. Only offered when no tool is currently armed (an armed tool already owns left-click for this). See the three entries above for what each one does." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click with an active selection (Sprite layer)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="If you have a sprite selection (drag a box with the Select tool first), right-clicking ANYWHERE on the canvas opens the same menu in batch mode instead of targeting a single object: Set Type / Set User Byte / Object Data... apply the pick to EVERY object in the selection at once, as one Undo step, overwriting whatever type/byte/object data each one already had. 'Link' is left out of this menu, since a link is always between exactly two objects, never a whole group." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a cell (Tilemap layer, GridSize=1 only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Opens a small dialog pre-filled with that ONE cell's current Mirror X/Y, Rotate, and palette slot (with a live preview of that cell). Not offered on an untouched/blank cell, or for 2x2/4x4 maps or the 8bpp layer (no attribute concept there). With no active grid selection, OK writes just this cell's attribute in place (never changes which tile is there, and never affects any other cell), Cancel discards." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Right-click a cell with an active selection" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Same dialog, but Mirror X/Mirror Y/Rotate now apply to every tile in the current selection, not just the clicked one, as soon as you click OK, no extra step needed. The preview image always shows just the clicked cell (a reference for how your changes look), even though other selected tiles end up looking different. If the selected tiles don't all already agree on one of the three checkboxes, that checkbox starts on a dash instead of checked/unchecked (Windows' standard 'mixed values' display): leave a dashed checkbox alone and every tile keeps its own value for that setting; click it (checked or unchecked) and that value is set on every tile in the selection. Palette slot is never part of this: it always applies to just the one clicked tile, selection or not." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+Z: Undo / Ctrl+Y: Redo" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A local undo/redo stack for this window: paint/erase strokes, Fill/Delete Selection, Move/Copy, Link, type assignment, and Resize/Trim each undo (and redo) as one step. A new edit after an Undo clears whatever Redo history existed, same as every other editor." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Ctrl+C: Copy / Ctrl+V: Paste" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Copies the current grid-cell or sprite selection; Ctrl+V pastes it under the cursor (snapped to the tile grid) and selects the pasted result immediately, switching to the Select tool, so it can be dragged into place. Works across maps: copy, switch to a different map in the list on the left, then paste: no remapping needed, since metatiles/tiles/sprites are shared project-wide. Pasting auto-switches to whichever layer was copied from. A pasted sprite's link (if it had one) is not carried over, same as a same-map Shift+drag copy. Pasting a group of objects near an edge or onto a smaller map skips whichever ones would land outside the map (the status line says how many); grid cells are clipped at the edge the same way." />
                    </StackPanel>
                </Expander>

                <!-- ================= 6. OTHER DIALOGS ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Other Dialogs" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource TermStyle}" Text="New Map" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Name and Width/Height (size presets, a live cell-count-vs-limit check; can be changed later via Resize/Trim). No metatile size choice here anymore: it's the whole project's own fixed size (see the Metatile Editor section)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Rename" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Names must be unique across the whole project (case-insensitive) since they become ASM export labels: validated live as you type." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Re-quantize" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Pick a dithering mode (None / Ordered 4x4 Bayer / Floyd-Steinberg) and re-convert from the original source region." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Palette Overflow" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Shown when an import/re-quantize can't fit its colours. 'Reduce this tile' caps the colour count and retries just this one. 'Re-quantize category' (4bpp only) rebuilds the ENTIRE category's palette bank from scratch at the reduced count: anything that still doesn't fit afterward is removed from the project, named in the status message so you can re-import it by hand. Any metatile cell that placed a re-quantized or removed tile is kept safe automatically (redirected to the replacement, or to the reserved blank tile if there's no replacement): it never ends up pointing at a tile that no longer exists." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="New Sub-folder" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Just a name: creates a one-level sub-folder. For Sprite4Bpp / Sprite8Bpp / Tile8Bpp it's a 'bank' sharing the category's palette (its own binary file on export); for Layer2 it gets its own independent palette." />
                    </StackPanel>
                </Expander>

                <!-- ================= 7. EXPORT ================= -->
                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Export: What Actually Gets Written" />
                    </Expander.Header>
                    <StackPanel Style="{StaticResource SectionContentStyle}">
                        <TextBlock Style="{StaticResource DescStyle}" Text="Every asset-folder/Layer2 row produces one or more chunked .bin files plus a matching .asm address file, plus a .pal file (always exactly 512 bytes). Every map row (grid/metatiles/objects) instead embeds its data directly as `db` bytes in one plain .asm file: no .bin, no .pal, no chunk size to pick, since there's no colour data or chunking involved." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Export dialog" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One row per asset folder, per Layer2 image, and per map (up to 5 rows: see the Map export section below). Every asset-folder/Layer2 row has its own Export checkbox and chunk-size choice (8 KB / 16 KB / Whole file); a Tile8Bpp row ALSO gets a Pixel order choice (see below). The 'What's this row?' column shows exactly which piece you're looking at: several rows can share the same folder (a map's 5 rows all live under 'map/MapName', for instance), so this is the column that actually tells them apart. The 4px colour bar at the left of each row matches the Project Tree's category tint (green 4bpp, blue 8bpp, violet Layer2, grey for a map's own rows). Clicking anywhere in a row toggles its Export checkbox." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Untyped object warning (red banner)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="If any placed object, on any map, has no type assigned (see 'Set Type' in the Map Editor section above), the Export dialog shows a bright red banner listing each one by map, sprite name, and position, e.g. 'Level1: Enemy at (32, 64)'. It's a heads-up only, not a block: an untyped object exports fine (its type byte is 0xFF, same as a deliberately untyped object) — the banner just catches a 'Set Type...' you may have forgotten before it ships." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Chunking rule" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="A single asset is NEVER split across two chunk files: if the next asset wouldn't fit in the current chunk, a new chunk starts instead. One chunk → Name.ext; several → Name_001.ext, Name_002.ext, ... 'Whole file' just means one chunk sized to fit everything." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Pixel order (Tile8Bpp only)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Row-major (default) or Column-major, per Tile8Bpp folder row. Tile8Bpp tiles are rendered by your own game code (there's no hardware tilemap for 8bpp), typically by blitting them into real Layer2 SRAM: whose hardware addressing is row-major for Layer2_256x192 but column-major for Layer2_320x256/640x256x4. Matching your target Layer2 mode's order here lets that blit be a plain sequential copy instead of per-pixel address math: pick whichever your game actually uses." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="File naming: a normal tile/sprite/Layer2 folder" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="{}{FolderPath}_gfx.{ext} for the binary/asm/palette (e.g. sprite/4bpp/images → sprite_4bpp_images_gfx.spr/.asm/.pal): the '_gfx' marks these as graphics-data files, matching the self-describing names the map exports already use (_tilemap_grid, _objects, etc.)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text=".asm format: graphics-map address files (per asset folder)" />
                        <TextBlock Style="{StaticResource CodeBlockStyle}" Text="s4_hero: equ 0           ; root sprite: pattern number = its map spriteIndex&#10;s4_hero_pal: equ 32      ; its palette, already in bits 7:4 (slot 2 * 16). An equ: zero bytes&#10;s4_walk_00: equ 0        ; sub-folder sprite: pattern number local to walk's own binary&#10;s4_walk_00_pal: equ 32&#10;&#10;t4_grass: equ 7          ; Tile4Bpp: the tile NUMBER&#10;t4_grass_pal: equ 48     ; its palette, already in bits 7:4 (slot 3 * 16)&#10;&#10;; optional, at the end of the file (Settings: 'Export palette lookup tables')&#10;s4_pal_table:            ; the same slots as DATA, indexable by spriteIndex&#10;    db 0,32,32,48&#10;s4_walk_pal_table:       ; each sub-folder gets its own, indexable by local index&#10;t4_pal_table:            ; Tile4Bpp: indexable by tile number&#10;&#10;s8_hero: equ 0           ; Sprite8Bpp: index within THIS file&#10;t8_ground: equ 0         ; Tile8Bpp root tile&#10;t8_hud_heart: equ 0      ; Tile8Bpp in sub-folder 'hud'" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Every category labels each asset by name (s4_ / t4_ / s8_ / t8_ prefix), sanitized for the assembler and de-collided per file with a _2 / _3 suffix. Sprite4Bpp: an `equ` pattern number plus an `equ` `_pal` palette value; Tile4Bpp: an `equ` tile number plus the same `equ` `_pal`. Both `_pal` values are ALREADY SHIFTED into bits 7:4 (slot * 16), the place hardware reads the palette from in a sprite attribute byte and in a tilemap attribute byte, so they OR straight in with no shifting; the raw slot number is in a trailing comment. Being `equ`, they cost no memory at all. The same values are additionally written as a real byte table at the END of the file, one contiguous run, for a runtime lookup by index: `s4_pal_table + spriteIndex`, `t4_pal_table + &lt;tile number&gt;`, and `s4_&lt;subfolder&gt;_pal_table + &lt;local index&gt;` for each sub-folder's own run. That table is the only part of the file that occupies bytes (about one per sprite/tile), so the Settings checkbox 'Export palette lookup tables' (on by default) can drop it when your code names the palette it wants directly. Note `t4_&lt;name&gt;` is the tile NUMBER now; it used to be the address of that tile's palette byte. Sub-folder sprites get an `s4_&lt;subfolder&gt;_&lt;name&gt;` label and a pattern number local to that sub-folder's binary (they're a bank, never map-placed). Sprite8Bpp / Tile8Bpp: a bare `equ` index local to this file (a sub-folder folds its name in: s8_ / t8_&lt;subfolder&gt;_&lt;name&gt;); no palette line, colour comes from the category's one flat palette shared across every sub-folder. For Sprite4Bpp / Sprite8Bpp / Tile8Bpp the whole category is one `.asm` and one palette file, with a separate binary per sub-folder." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="The 'index' byte for a tile/sprite reference" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Is NOT its position in your project tree: it's its 0-based rank among the category's ROOT-folder assets, ordered by creation order, after any deletions. User sub-folder tiles/sprites are a separate 'bank' and are never referenced this way, so adding them never shifts a root asset's index. This is the same number the tree shows as '[N]' and the same one the asm's s8_/t8_/... label carries. (Max 256 root assets per category referenceable this way: export is blocked with a clear message if you go over.)" />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Tilemap tile animation: a Tile4Bpp sub-folder is a frame bank" />
                        <TextBlock Style="{StaticResource CodeBlockStyle}" Text="Tile4Bpp/                      ; root: the 256 placeable tilemap tiles&#10;  spike_animation/             ; a sub-folder = one animation's frame bank&#10;    ..._spike_animation_gfx.til  ; its own binary, 32 bytes a tile&#10;&#10;t4_spike_animation_f0_0: equ 0   ; bank index; byte offset = n * 32&#10;t4_spike_animation_f0_1: equ 1&#10;...&#10;; frame 0 = bank tiles 0..3 (4-tile target), frame 1 = 4..7, ...&#10;&#10;tm_anim_spike_animation_seq:        equ 1   ; targets consecutive&#10;tm_anim_spike_animation_first:      equ 80  ; first tile overwritten&#10;tm_anim_spike_animation_tiles:      equ 4&#10;tm_anim_spike_animation_frames:     equ 6&#10;tm_anim_spike_animation_frame_size: equ 128&#10;tm_anim_spike_animation_offset:     equ 0   ; frame 0 in the bank&#10;&#10;; LDIR frame_size bytes from bank + offset + frame*frame_size&#10;;   to &lt;tile definitions base&gt; + first*32" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Animating the hardware tilemap is nothing but substituting tile GRAPHICS: copy 32 bytes over a tile's pattern and every map cell using that tile animates for free. So the frames must live OUTSIDE the 256 placeable tiles, which is what a Tile4Bpp sub-folder is for: its tiles take no tilemap tile index, never appear in the Metatile Editor palette, and export to their own binary. A bank is RAW POSITIONAL data, not a set of pictures: nothing is de-duplicated and nothing is dropped, so a fully transparent position becomes a real transparent tile and two identical positions stay two tiles (the slicer's 'Skip duplicate cells' is forced off there). If a position were dropped, every later frame would shift by that many bytes and the animation would break on hardware, which is exactly the trap this avoids. The bank's labels are equ bank indices, not palette bytes, so they cost no bytes in your program. Right-click the folder for 'Animation target...' and pick, as a picture, either the metatile whose tiles the frames replace (one frame = all its tiles) or a single tile (one frame = 32 bytes). From that the app works out tiles per frame, how many complete frames the folder holds and bytes per frame, and it ENFORCES the rule that silently ruins an animation: each frame tile is quantized into the palette slot its target renders with, because substituting pixels never rewrites a map cell's attribute byte, which is where the slot lives. The position comes from the folder's tile order, so slicing a whole animation at once cycles through the target slots by itself; missing colours are added to that slot's free entries only, never replacing what is there, so every other tile in the slot keeps rendering as before; and if they do not fit, the import is refused with a message naming the slot (the usual palette-overflow dialog then lets you reduce colours and retry, which is the only real remedy: no other slot would be correct). The export writes the arithmetic as tm_anim_&lt;folder&gt;_* constants at the end of the bank's own asm section, so your copy loop hardcodes nothing and survives any later tile renumbering; seq = 0 plus a targets table replaces first when the targets are not consecutive, and the export stops with a clear message rather than emitting wrong numbers when a frame is incomplete, a target is gone, or the bank was split across several binary files by the chunk size. The dialog also reports an incomplete trailing frame, a target tile that no longer exists, targets that are not consecutive tile numbers (one linear copy per frame cannot land on them: reorder them next to each other in the tree), and the OTHER metatiles built from the same tiles, since substituting a pattern is global and animates those too (the same four tiles mirrored into four orientations is the usual case, and usually wanted). The setting is stored on the folder in the project and survives tile reordering, since it references tiles rather than their numbers. 'Delete unused...' skips frame banks, which it would otherwise wipe completely, as no map places a frame. The copy itself and the frame timing are your own code's business: the app stores nothing about delays." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="Map export: per map, per layer, no separate .bin files" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Each map produces up to 6 asm files (each with an explanatory comment header, fewer for a 1x1 map, see below), all with the data embedded directly as `db n,n,n,...` lines: no matching .bin/.pal file for any of them, and no chunk-size choice in the Export dialog (there's nothing to chunk). The map's name is put through the assembler-label sanitizer first (a space or '.' becomes '_', a leading digit gets an '_' in front), since that name prefixes every label in these files and is also their filename: a map called 'my level' exports my_level_tilemap_grid.asm with my_level_... labels. A name that is already label-safe is used as-is." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="{}{MapName}_tilemap_grid.asm / {MapName}_8bpp_grid.asm" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="For a 2x2/4x4 map: 1 byte per cell, Width/Height emitted as `equ` constants, and each byte is a metatile index LOCAL to this map+layer's own metatile-definitions file below (NOT that metatile's project-wide creation order); an unpainted/erased cell references index 0, that Kind+GridSize's auto-generated 'Blank' reserved metatile. For a 1x1 map there is no metatile indirection at all: each cell IS that tile's own index directly (2 bytes for Tilemap: tile index then attribute byte, same layout as the metatiles file below, including bit 0 — see 'Tilemap attribute byte, bit 0' below; 1 byte for 8bpp), and there is no matching _metatiles.asm file for that layer." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="{}{MapName}_info.asm (map geometry, MODULE-scoped)" />
                        <TextBlock Style="{StaticResource CodeBlockStyle}" Text="    MODULE level1      ; outside: level1.w_px, level1.hdr, ...&#10;cell_t:   equ 2        ; metatile side, in tiles&#10;cell_px:  equ 16       ; metatile side, in px&#10;cell_psh: equ 4        ; px = mt &lt;&lt; cell_psh&#10;w_mt/w_t/w_px:    40 / 80 / 640&#10;h_mt/h_t/h_px:    25 / 50 / 400&#10;left_*, top_*:    0        ; inclusive edges&#10;right_mt/_t/_px:  39 / 79 / 639&#10;bottom_mt/_t/_px: 24 / 49 / 399&#10;cells:    equ 1000     ; w_mt * h_mt&#10;tm_bpc/tm_row/tm_size: 1 / 40 / 1000&#10;l2_bpc/l2_row/l2_size: 1 / 40 / 1000&#10;hdr:                   ; same numbers as dw/db data&#10;hdr_w_px:  dw 640      ; +4&#10;hdr_len:   equ 40      ; bytes in hdr&#10;    ENDMODULE" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One file per map (not per layer) holding the whole map's geometry, so game code never recomputes a bound or a unit conversion. Everything sits in a sjasmplus MODULE named after the map, which is what lets the names be this short: w_px inside the module is level1.w_px outside, so every map's info file can be assembled together with no clash. Each measurement comes in all three units at once: _mt = metatile cells (the unit the grid bytes are in), _t = 8x8 hardware tiles, _px = pixels (the unit an object's X/Y in _objects.asm uses). All four sides come in those same units as INCLUSIVE extreme coordinates: left_/top_ are always 0, right_/bottom_ are the last valid coordinate, so a bounds test is a plain compare with no -1. cell_t/cell_px give the metatile size, cell_tsh/cell_psh the matching shift counts for converting units with shifts instead of multiplication, and tm_*/l2_* describe each grid layer's bytes: only a 1x1 map's Tilemap layer is 2 bytes/cell (tile index + attribute), every other grid layer is 1. The equ constants cost no bytes but are fixed at assembly time; the hdr: block below them repeats the same numbers as real dw/db data, so one generic routine can be handed a pointer (ld hl, level1.hdr) for any map instead of being built against a specific one. Its 16-bit fields come first and its byte fields after, each with its own label (ld bc,(level1.hdr_w_px)) and a ; +offset comment, closing with hdr_len. On an extreme map where a field would not fit a 16-bit word the hdr: block is dropped entirely, with a comment naming the overflowing field, rather than writing one truncated value; the equ constants stay exact either way. The _info postfix is configurable in Settings like every other export postfix." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="{}{MapName}_tilemap_metatiles.asm / {MapName}_8bpp_metatiles.asm" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Only produced if that layer actually places any metatiles AND the map's GridSize isn't 1 (a 1x1 map never produces this file, see the grid file above). Lists, in order, every distinct metatile that layer uses (or, with the per-project Settings option 'Export all metatiles' on, every metatile of that kind, placed or not, in project order): index 0, 1, 2... in this file IS the local index the grid file above references. Each metatile's record also carries its own address label, &lt;map&gt;_&lt;layer&gt;_metatiles_&lt;metatile name&gt;: (sanitized, de-collided per file with a _2 / _3 suffix, and kept clear of the file's _count / _size constants), so code can reference a metatile by name; this is additive, the local index and record order are unchanged. Tilemap (4bpp): 2 bytes/tile: tile-index byte, then an attribute byte (bits 7-4 = palette slot 0-15, bit 3 = Mirror X, bit 2 = Mirror Y, bit 1 = Rotate, bit 0 = ULA-over-tilemap — see 'Tilemap attribute byte, bit 0' below). 8bpp: 1 byte/tile (index only, no attribute). The metatile size (2x2/4x4) is stated once in the file's header comment/constants: a map only ever uses one size. There is no project-wide metatile library any more: if two maps share a metatile, each map's own file gets an independent full copy of its data." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="Tilemap attribute byte, bit 0 (ULA-over-tilemap)" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Real Next hardware (nextreg 0x6C's layout) reserves bit 0 of the Tilemap attribute byte as a per-tile ULA-over-tilemap priority flag. This app writes the SAME value to bit 0 of every 4bpp Tilemap tile it exports (both the 1x1 direct-cell format and every metatile cell), controlled by one Settings checkbox, 'Set ULA-over-tilemap bit (bit 0) on every exported Tilemap attribute byte': off (default) writes 0 everywhere, as before; on writes 1 everywhere instead. It is a single project-wide export switch, not a per-tile editor control: there is no way to set it per individual tile. The header comment of every affected _grid.asm/_metatiles.asm file states which value it used." />
                        <TextBlock Style="{StaticResource TermStyle}" Text="{}{MapName}_objects.asm" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="The Sprite layer's placements (called 'objects' in export, since these are map placements, not the sprite assets themselves): ONE `db` line per object (never wrapped at 16 bytes like the grid/metatile files: 8 doesn't divide evenly, so keeping one clean record per line matters more here for a programmer reading the file), each preceded by a comment naming the sprite, its position, its type (if any), and its link target (if any). Record order is NOT placement order: objects are grouped by their type's position in object_types.asm's list (so moving a type up in 'Manage Types...' makes its objects initialize earlier on hardware), with untyped objects always written last. Within one type's group, objects keep the order you placed them in -- they are NOT further sub-grouped by sprite, so e.g. several 'fly' objects placed at different times can still end up non-adjacent within the 'enemy' group if other enemy sprites were placed in between. The link ('connect') byte always points at the correct target by its FINAL (post-sort) position, however the sort reorders things, so Link survives reordering intact. The count is written as an ASM constant (e.g. MyMap_objects_count: equ 12), followed by one MyMap_objects_&lt;type name&gt;_count: equ constant per project-wide Object Type (from 'Manage Types...'), in that list's order, even for a type this map places 0 of -- so game code can always rely on every type's count constant existing. MyMap_objects: labels the start of the whole table. Each object's four extended bytes (width, height, drawX, drawY) are written on their own db line right after its record, inside an IFDEF OBJ_EXT block, so the record is 8 bytes with that symbol undefined and 12 with it defined; MyMap_objects_obj_size: equ is that same length as a constant, switched by the same IFDEF, so your loop never hardcodes 8 or 12. An object's X/Y is the corner of its COLLISION BOX, never of its picture: the whole engine knows an object as X, Y, width and height, so width/height are the box (drawn by hand in the Object Editor, see Hitbox below) and drawX/drawY are the signed step from the box back to where the picture is drawn. They are minus the box's own offset, so a drawing routine adds one byte and does no arithmetic; an object nobody drew a box on exports 0 for both, which is the picture and the box in the same place, exactly as before. A palette byte used to lead that block and no longer does: every sprite of an object carries its own palette in object_anims.asm, which is where the drawing routine reads it. The symbol is defined (or left commented out) in ONE place, the project-wide object_types.asm, so every map in a build agrees on the record size; the Settings checkbox 'Extended object bytes' only decides which of those two forms that line is written in, and uncommenting it by hand in the exported source works just as well, with no re-export." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Every object's `db` line also carries its own address label, MyMap_objects_&lt;sprite name&gt;_&lt;x&gt;_&lt;y&gt;:, so game code can reference an object by name with no address arithmetic. The label is the sprite asset's name plus the placement's X and Y (two placements of the same sprite still get different labels); a _2 / _3 suffix is added only if even the coordinates are identical. The name is put through the same assembler-label sanitizer as the tile/sprite labels." />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Each Object Type also gets a block label, MyMap_objects_&lt;type name&gt;:, written right before the FIRST object of that type (objects are already grouped by type, see above), so game code can jump straight to one type's run of records instead of scanning the whole table. A type placing 0 objects on this particular map gets no block label, and untyped objects never get one either." />
                        <TextBlock Style="{StaticResource CodeBlockStyle}" Text="Object record (8 bytes, or 12 with extended bytes on):&#10;  byte 0    spriteIndex&#10;  bytes 1-2 X  (int16, little-endian) -- the BOX's corner&#10;  bytes 3-4 Y  (int16, little-endian) -- the BOX's corner&#10;  byte 5    type    (obj_&lt;name&gt; index from object_types.asm, 0xFF = no type)&#10;  byte 6    connect (index of the linked object in THIS file, 0xFF = no link)&#10;  byte 7    userByte (the per-object User Byte 0-255, set in the Map Editor)&#10;  -- the four below are written inside IFDEF OBJ_EXT --&#10;  byte 8    width   (box, pixels, 0-255)&#10;  byte 9    height  (box, pixels, 0-255)&#10;  byte 10   drawX   (SIGNED: X + drawX = where the picture is drawn)&#10;  byte 11   drawY   (SIGNED: Y + drawY = where the picture is drawn)" />

                        <TextBlock Style="{StaticResource TermStyle}" Text="object_anims.asm" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One project-wide file (not per-map), written whenever the project has any named objects: one self-contained animation table per animation of every object, for your own sprite-drawing routine. A table is the frame count, then one `dw` per frame; a frame is its duration and its sprite count and nothing else, then the ANCHOR sprite as two bytes (palette, pattern) with NO offset of its own, then four bytes per following sprite (dx, dy, palette, pattern) whose dx/dy are SIGNED, measured from the anchor&apos;s top-left pixel. The anchor is the frame&apos;s first sprite in reading order. The palette byte is each sprite&apos;s own 4bpp slot ALREADY SHIFTED into bits 7:4, so it ORs straight into a sprite attribute byte and one frame may freely mix palette slots. A frame carries NO mirror or drawing corrections: the engine works the x-mirror correction out from the object&apos;s own box, and where the picture sits relative to that box is a property of the object, travelling with each map placement as the drawX/drawY bytes of its record. Everything here is measured from the object&apos;s own layout; the only hand-typed number is a frame&apos;s duration. Each animation also gets an `obj_&lt;object&gt;_&lt;animation&gt;: equ &lt;table&gt;` alias, so your code names an animation instead of carrying its address; there is deliberately no table of animation addresses above them. A sprite taken from a sub-folder exports the pattern number local to that sub-folder&apos;s own binary, so a table using one only works while that bank is loaded (the editor says so in red)." />
                        <TextBlock Style="{StaticResource CodeBlockStyle}" Text="a_hero_walk:&#10;    db 2                   ; frames&#10;    dw a_hero_walk_f0&#10;    dw a_hero_walk_f1&#10;a_hero_walk_f0:&#10;    db 6,3          ; duration, sprites&#10;    db 16,0         ; anchor: palette (slot 1, pre-shifted), pattern&#10;    db 248,16,16,1  ; dx -8, dy 16, palette, pattern&#10;    db 8,16,16,1    ; dx +8, dy 16, palette, pattern&#10;a_hero_walk_f1:&#10;    db 6,3&#10;    ...&#10;&#10;obj_hero_walk: equ a_hero_walk" />

                        <TextBlock Style="{StaticResource TermStyle}" Text="object_types.asm" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One project-wide file (not per-map), only written if the project has any Object Types defined: see the Map Editor's 'Manage Types...' dialog. One `obj_&lt;name&gt;: equ &lt;index&gt;` line per type, in list order; that index is exactly what every map's _objects.asm writes as the `type` byte, so it's consistent across every map in the export. That same list order is also the init-priority used to sort every map's exported object list (see the _objects.asm entry above), and can be changed with the Move Up/Down buttons in 'Manage Types...'. The name is put through the assembler-label sanitizer (a space or '.' becomes '_') and de-collided per file, like every other exported name label. This file also carries the project's single 'DEFINE OBJ_EXT' line, written active when the Settings checkbox 'Extended object bytes' is on and commented out when it is off: that one line switches every map's object records between 8 and 12 bytes, which is why it lives here rather than in each map's own file (a DEFINE is global to the whole assembly, so a per-map copy would both clash and let two maps disagree depending on include order). A type's own palette and size are deliberately NOT written here as constants: an object record already carries its final width and height, and a sprite's palette travels with the sprite in object_anims.asm, so a per-type copy could only disagree with the data. With the checkbox on, this file is written even if the project has no object types at all, since the DEFINE line has to exist somewhere. Every object type's named SUBTYPES are written here too, grouped under a comment naming their type: subobj_&lt;name&gt;: equ &lt;bit value&gt;, one bit of an object's userByte each, as the bit's value (1, 2, 4, ...) so it tests with a plain AND. The label has no type name in it, which is why subtype names are unique project-wide." />

                        <TextBlock Style="{StaticResource TermStyle}" Text="Layer2 export" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="One image = one blob spanning consecutive chunks, byte order depends on resolution: 256x192 is plain row-major; 320x256 is column-major (top-to-bottom, then next column); 640x256x4 is column-major AND packs 2 adjacent pixels per byte (high nibble = left pixel)." />

                        <TextBlock Style="{StaticResource TermStyle}" Text=".pal file format" />
                        <TextBlock Style="{StaticResource DescStyle}" Text="Always exactly 512 bytes, matching the Next hardware's own 2-write palette format: the first 256 bytes are one RRRGGGBB byte per colour entry; the last 256 are one byte per entry with the blue low bit in bit 0 and, for a Tile8Bpp colour marked Priority (see the Project Tree section), bit 7 set: the Layer2 'draw on top of everything' flag, which only takes effect when your code loads this palette as the Layer2 palette (nextreg 0x43 = Layer2). A 4bpp category gets ONE combined 256-entry file (all 16 bank slots back to back); every other palette-owning row gets its own 512-byte file straight from its folder/image palette." />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
