<UserControl x:Class="ZxNext.App.Views.ImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ImageViewerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border BorderBrush="#333" BorderThickness="1" Margin="4">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedAssetName}"
                       HorizontalAlignment="Center" FontSize="13" Margin="4" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding UsageInfo}"
                       HorizontalAlignment="Center" FontSize="11" Foreground="#666" Margin="4,0,4,4" TextWrapping="Wrap" />
            <!-- Wheel zooms around the cursor, middle-drag pans; reset whenever another picture is shown. -->
            <Border x:Name="ViewportHost" ClipToBounds="True" Background="Transparent"
                    PreviewMouseWheel="Viewport_OnPreviewMouseWheel" MouseDown="Viewport_OnMouseDown"
                    MouseMove="Viewport_OnMouseMove" MouseUp="Viewport_OnMouseUp" LostMouseCapture="Viewport_OnLostMouseCapture">
            <Image x:Name="PixelImage" Source="{Binding Bitmap}" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0,0"
                   MouseLeftButtonDown="PixelImage_OnMouseLeftButtonDown"
                   MouseMove="PixelImage_OnMouseMove"
                   MouseLeftButtonUp="PixelImage_OnMouseLeftButtonUp"
                   LostMouseCapture="PixelImage_OnLostMouseCapture">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomTransform" />
                        <TranslateTransform x:Name="PanTransform" />
                    </TransformGroup>
                </Image.RenderTransform>
                <!-- An asset is shown at most 256 px; a source image (often large) gets the whole viewer. -->
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="MaxWidth" Value="256" />
                        <Setter Property="MaxHeight" Value="256" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSourcePreview}" Value="True">
                                <Setter Property="MaxWidth" Value="Infinity" />
                                <Setter Property="MaxHeight" Value="Infinity" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
