<Window x:Class="ZxNext.App.Views.TileAnimationTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Animation target" SizeToContent="Height" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- One row = the picture first, then the name and the tile numbers. The picture is what the user
             recognises; the numbers matter because the game's copy destination is computed from them. -->
        <DataTemplate x:Key="ChoiceTemplate">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Border BorderBrush="#555" BorderThickness="1" Background="#222" VerticalAlignment="Center">
                    <Image Source="{Binding Preview}" Width="{Binding PreviewSize}" Height="{Binding PreviewSize}"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#777" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="14">
        <TextBlock x:Name="FolderText" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="This folder's tiles are animation frames: the game copies a frame over its target's tiles at runtime. Pick that target, and the app knows how many tiles make one frame and which palette slot each position must use."
                   FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
            <TextBlock Text="Animate:" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton x:Name="MetatileModeRadio" Content="a metatile" GroupName="Mode" IsChecked="True"
                         Checked="Mode_OnChecked" VerticalAlignment="Center" Margin="0,0,14,0"
                         ToolTip="Every tile of the metatile is replaced: one frame = that many tiles" />
            <RadioButton x:Name="TileModeRadio" Content="a single tile" GroupName="Mode"
                         Checked="Mode_OnChecked" VerticalAlignment="Center"
                         ToolTip="One tile is replaced: one frame = one tile, 32 bytes" />
        </StackPanel>

        <ListBox x:Name="MetatileList" Height="210" SelectionChanged="Choice_OnSelectionChanged"
                 ItemTemplate="{StaticResource ChoiceTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <ListBox x:Name="TileList" Height="210" SelectionChanged="Choice_OnSelectionChanged" Visibility="Collapsed"
                 ItemTemplate="{StaticResource ChoiceTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <TextBlock x:Name="TargetDetailText" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="SharedWarningText" FontSize="11" Foreground="#B8860B" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="StateText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock x:Name="ProblemText" FontSize="11" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ClearButton" Content="Clear target" Width="100" Margin="0,0,8,0" Click="Clear_OnClick"
                    ToolTip="Forget what this folder animates. The frame tiles themselves are left alone." />
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="Ok_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
