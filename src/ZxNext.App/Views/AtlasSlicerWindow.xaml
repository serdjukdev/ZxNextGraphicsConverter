<Window x:Class="ZxNext.App.Views.AtlasSlicerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:AtlasSlicerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Slice Atlas" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" MaxWidth="420" Margin="0,0,0,10"
                   Text="This image is larger than one cell. Set the grid below, then slice it into individual tiles/sprites." />

        <Border BorderBrush="#666" BorderThickness="1" HorizontalAlignment="Left">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxWidth="520" MaxHeight="420">
                <Grid x:Name="PreviewHost">
                    <Image x:Name="PreviewImage" Source="{Binding SourcePreview}" Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="GridOverlay" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Offset left" FontSize="11" />
                <TextBox Text="{Binding OffsetLeft, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Offset top" FontSize="11" />
                <TextBox Text="{Binding OffsetTop, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Spacing" FontSize="11" />
                <TextBox Text="{Binding Spacing, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,10,0,0" FontWeight="Bold">
            <Run Text="Cells found: " /><Run Text="{Binding CellCount, Mode=OneWay}" />
        </TextBlock>

        <CheckBox Content="Skip duplicate cells (identical pixels imported only once)"
                  IsChecked="{Binding SkipDuplicateCells}" Margin="0,8,0,0" />

        <CheckBox x:Name="MetatileBlocksCheckBox"
                  Content="Slice into metatile blocks (auto-creates a metatile per block)"
                  IsChecked="{Binding SliceIntoMetatileBlocks}" Margin="0,8,0,0"
                  Visibility="{Binding SupportsMetatileBlockSlicing, Converter={StaticResource BoolToVis}}"
                  Checked="MetatileBlocksCheckBox_OnChecked"
                  ToolTip="Cuts the atlas into NxN-tile blocks (N = this project's metatile size) instead of individual 8x8 tiles, splitting each block into its 8x8 tiles and auto-building a metatile from them." />

        <CheckBox Content="Place the transparent tile first (index 0)" IsChecked="{Binding PlaceTransparentTileFirst}" Margin="0,4,0,0"
                  Visibility="{Binding CanOfferTransparentTileFirst, Converter={StaticResource BoolToVis}}"
                  ToolTip="This slice includes a fully transparent cell and this category has no designated transparent tile yet — put it at the front of the list so it's easy to find (e.g. as a 'walk-through' tile) instead of scrolling through the rest." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Slice &amp; Import" Width="120" IsDefault="True" Click="Confirm_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
