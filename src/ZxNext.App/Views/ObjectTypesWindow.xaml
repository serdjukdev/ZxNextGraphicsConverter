<Window x:Class="ZxNext.App.Views.ObjectTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ObjectTypesViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Object Types" Height="470" Width="360" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A7A1A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                    <Setter Property="Foreground" Value="Red" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Object types are shared across every map (see the Help topic on map export) — used to categorize Sprite-layer objects, e.g. for a game's own trigger/behaviour logic. List order also sets each type's export equ number AND the init order of its objects in every map's _objects.asm (move a type up to make its objects initialize earlier on hardware)." FontSize="10" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#999" BorderThickness="1">
                <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Name" BorderThickness="0" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Content="&#9650;" Style="{StaticResource IconButtonStyle}" Margin="0,0,0,4"
                        Command="{Binding MoveTypeUpCommand}" ToolTip="Move this type earlier (initializes earlier on hardware, lower equ number)" />
                <Button Content="&#9660;" Style="{StaticResource IconButtonStyle}"
                        Command="{Binding MoveTypeDownCommand}" ToolTip="Move this type later (initializes later on hardware, higher equ number)" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding HasSelectedType}">
            <TextBlock Text="Selected type's object data (exported as bytes 8-10 of every object of this type)" FontSize="10" Foreground="Gray" TextWrapping="Wrap" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Palette 0-15" FontSize="11" />
                    <TextBox Text="{Binding SelectedPaletteIndex, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Hardware palette number, exported in the high 4 bits of the object's palette byte (the low 4 bits are 0, reserved)." />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="Width px" FontSize="11" />
                    <TextBox Text="{Binding SelectedWidth, UpdateSourceTrigger=PropertyChanged}" ToolTip="Width in pixels, 0-255." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Height px" FontSize="11" />
                    <TextBox Text="{Binding SelectedHeight, UpdateSourceTrigger=PropertyChanged}" ToolTip="Height in pixels, 0-255." />
                </StackPanel>
            </Grid>
            <TextBlock Text="These are the type's defaults: a single object can override any of them from its own right-click menu in the Map Editor. They only reach the binary while 'Extended object bytes' is on in Settings." FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Add" MinWidth="70" Command="{Binding AddTypeCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
            <Button Grid.Column="1" Content="Rename" Width="70" Command="{Binding RenameTypeCommand}" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="Delete" Width="70" Command="{Binding DeleteTypeCommand}" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Content="Close" Width="80" HorizontalAlignment="Right" IsCancel="True" Click="Close_OnClick" />
        </Grid>
    </Grid>
</Window>
