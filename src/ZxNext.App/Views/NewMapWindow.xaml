<Window x:Class="ZxNext.App.Views.NewMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:NewMapViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Map" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16" Width="340">
        <TextBlock Text="Name" FontSize="11" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Text="Height:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <Button Content="64x64" Width="64" Margin="0,0,6,0" Command="{Binding SetPresetSizeCommand}" CommandParameter="64x64" />
            <Button Content="128x64" Width="64" Margin="0,0,6,0" Command="{Binding SetPresetSizeCommand}" CommandParameter="128x64" />
            <Button Content="128x128" Width="70" Command="{Binding SetPresetSizeCommand}" CommandParameter="128x128" />
        </StackPanel>

        <TextBlock Text="{Binding ValidationText}" FontSize="10" TextWrapping="Wrap" Foreground="Gray" MinHeight="14" Margin="0,0,0,10" />

        <TextBlock Text="Metatile grid size" FontSize="11" />
        <ComboBox ItemsSource="{Binding AvailableGridSizes}" DisplayMemberPath="Label"
                  SelectedValuePath="Value" SelectedValue="{Binding MetatileGridSize}" Width="90" HorizontalAlignment="Left" Margin="0,2,0,4" />
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,0,0,10"
                   Text="Width/Height can be changed later (Resize/Trim, once that tool exists). Metatile grid size is fixed forever once this map is created — both grid layers share it." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Create" Width="90" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Create_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
