<Window x:Class="ZxNext.App.Views.ReQuantizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ReQuantizeViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Re-quantize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="14" Width="300">
        <TextBlock Text="Re-converts this tile/sprite from its original source region, replacing its current pixels."
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="Dithering" FontSize="11" Margin="0,0,0,2" />
        <ComboBox ItemsSource="{Binding AvailableDitherModes}" SelectedItem="{Binding SelectedDitherMode}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="Re-quantize" Width="100" IsDefault="True" Click="Confirm_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
