<UserControl x:Class="ZxNext.App.Views.SourceImagesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SourceImagesPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AllowDrop="True" Drop="Panel_OnDrop">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="Source Images" FontWeight="Bold" Margin="4,4,4,0" />
        <TextBlock DockPanel.Dock="Top" Text="File → Import Images..., or drop files here" FontSize="10" Foreground="Gray" Margin="4,0,4,4" />
        <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 PreviewMouseLeftButtonDown="Item_OnPreviewMouseLeftButtonDown"
                 PreviewMouseMove="Item_OnPreviewMouseMove">
            <ListBox.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedImageCommand}" />
            </ListBox.InputBindings>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SourceImageViewModel}">
                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Image Source="{Binding Thumbnail}" Width="32" Height="32"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" />
                                    <TextBlock FontSize="10" Foreground="Gray">
                                        <Run Text="{Binding Width, Mode=OneWay}" /><Run Text="x" /><Run Text="{Binding Height, Mode=OneWay}" />
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding AvailableDitherModes}"
                                              SelectedItem="{Binding DitherMode}"
                                              ToolTip="Changing this re-quantizes every tile/sprite already placed from this image"
                                              FontSize="10" Padding="2" Width="88" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Width="20" Height="20" Padding="0"
                                    VerticalAlignment="Top" Margin="4,0,0,0"
                                    ToolTip="Delete this source image"
                                    Click="DeleteSourceImage_OnClick" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
