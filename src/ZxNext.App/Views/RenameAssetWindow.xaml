<Window x:Class="ZxNext.App.Views.RenameAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Rename" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="14" Width="280">
        <TextBlock Text="New name (this becomes its ASM export label):" FontSize="11" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" TextChanged="NameBox_OnTextChanged" />
        <TextBlock x:Name="ValidationText" Foreground="Red" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button x:Name="RenameButton" Content="Rename" Width="80" IsDefault="True" Click="Rename_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
