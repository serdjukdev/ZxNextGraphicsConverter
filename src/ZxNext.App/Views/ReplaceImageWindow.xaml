<Window x:Class="ZxNext.App.Views.ReplaceImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZxNext.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ReplaceImageViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Replace Image" Width="960" Height="700" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="New picture for " /><Run Text="{Binding AssetName, Mode=OneWay}" FontWeight="Bold" /><Run Text=". Its name, export index and everything placed with it stay as they are." />
        </TextBlock>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Width="210" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Source image" FontSize="11" Margin="0,0,0,4" />
                <Button DockPanel.Dock="Bottom" Content="Browse..." Margin="0,6,0,0" Command="{Binding BrowseCommand}"
                        ToolTip="Pick a file from disk. It is added to the project's source images first, so this tile can still be re-quantized later." />
                <ListBox x:Name="SourceList"
                         ItemsSource="{Binding Sources}"
                         SelectedItem="{Binding SelectedSource}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Thumbnail}" Width="40" Height="40" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,6,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                    <TextBlock FontSize="10" Foreground="#888">
                                        <Run Text="{Binding Width, Mode=OneWay}" /><Run Text="x" /><Run Text="{Binding Height, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Zoom" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="ZoomLabel" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" MinWidth="44" />
                    <TextBlock Text="{Binding AimHintText}" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="Middle mouse button drags the picture." FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="#666" BorderThickness="1">
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#222" Focusable="True"
                                  SizeChanged="PreviewScroll_OnSizeChanged"
                                  PreviewMouseWheel="PreviewScroll_OnPreviewMouseWheel"
                                  PreviewMouseDown="PreviewScroll_OnPreviewMouseDown"
                                  PreviewMouseMove="PreviewScroll_OnPreviewMouseMove"
                                  PreviewMouseUp="PreviewScroll_OnPreviewMouseUp">
                        <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="#222" MouseLeftButtonDown="PreviewHost_OnMouseLeftButtonDown">
                            <Image x:Name="PreviewImage" Source="{Binding SelectedSource.Thumbnail}" Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Canvas x:Name="RectOverlay" IsHitTestVisible="False" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="0,8,0,0" Width="320" HorizontalAlignment="Left"
                      ToolTip="Where the cell grid starts in this image, in pixels. Use it for a sheet with a border, or one whose cells don't start on a multiple of the tile size. Applies as you type.">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Image offset" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,8,3" />
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="left" FontSize="11" />
                        <TextBox Text="{Binding OriginX, UpdateSourceTrigger=PropertyChanged}" KeyDown="OffsetBox_OnKeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="top" FontSize="11" />
                        <TextBox Text="{Binding OriginY, UpdateSourceTrigger=PropertyChanged}" KeyDown="OffsetBox_OnKeyDown" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding PlacementText}" Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_OnClick" />
            <Button x:Name="ReplaceButton" Content="Replace" Width="100" IsDefault="True" Click="Confirm_OnClick"
                    IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </Grid>
</Window>
